{
  "Parameters": {
    "commands": [
      "cd /home/appuser/hospital-app/incodefy",
      "AWS_REGION=us-east-2 ENVIRONMENT=production ../scripts/fetch-env-from-aws.sh",
      "pkill -f 'node.*server.js' || true",
      "nohup node server.js > /tmp/app.log 2>&1 &",
      "sleep 3",
      "ss -tlnp 2>/dev/null | grep :3000 && echo 'Server started' || echo 'Failed'"
    ]
  }
}
