# Configuración de la aplicación
NODE_ENV=development
PORT=3000

# Session Secret - ¡OBLIGATORIO EN PRODUCCIÓN!
# Genera uno único con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Orígenes permitidos para CORS (separados por comas)
# Ejemplo: http://localhost:3000,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000

# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu-password
DB_NAME=incodefy

# AWS Cognito
AWS_REGION=us-east-1
USER_POOL_ID=us-east-1_XXXXXXXXX
USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Credentials (Solo para desarrollo local o EC2)
aws_access_key_id=YOUR_ACCESS_KEY_ID
aws_secret_access_key=YOUR_SECRET_ACCESS_KEY
aws_session_token=YOUR_SESSION_TOKEN

# API Backend (AWS Lambda/API Gateway)
API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# KMS Key ID para encriptación de PII (si se usa en frontend)
# Solo necesario si el frontend encripta/desencripta datos localmente
# KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012

# Email del administrador para notificaciones de seguridad
# (Rotation failures, security alerts, etc.)
ADMIN_EMAIL=admin@hospital.com

# Debug mode (opcional) - mostrar logs detallados
DEBUG=false

# Retry configuration para ApiClientV2
API_MAX_RETRIES=3
API_RETRY_DELAY=1000
