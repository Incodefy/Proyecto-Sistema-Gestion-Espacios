<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configuración de Espacios</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/fontawesome/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/onboarding-espacios.css">
</head>
<body data-theme="light">
  <div class="onboarding-container">
    <div id="onboarding-root"></div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/onboarding-espacios.js"></script>
  <script nonce="<%= cspNonce %>">
    window.userPersonalization = <%- JSON.stringify(personalization || {}) %>;
    window.csrfToken = '<%= csrfToken %>';
  </script>
</body>
</html>