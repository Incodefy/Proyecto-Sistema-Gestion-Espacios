<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Configuración inicial de espacios - Onboarding del sistema">
  <title>Configuración de Espacios</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/fontawesome/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/onboarding-espacios.css?v=<%= Date.now() %>">
</head>
<body data-theme="light">
  <!-- Botón de cerrar sesión -->
  <a href="/logout" class="logout-button" title="Cerrar sesión">
    <i class="fas fa-sign-out-alt"></i>
    <span>Cerrar sesión</span>
  </a>
  
  <main class="onboarding-container" role="main" aria-label="Configuración de espacios">
    <div id="onboarding-root" role="region" aria-label="Asistente de configuración"></div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/onboarding-espacios.js?v=<%= Date.now() %>"></script>
  <script nonce="<%= cspNonce %>">
    window.userPersonalization = <%- JSON.stringify(personalization || {}) %>;
    window.csrfToken = '<%= csrfToken %>';
  </script>
</body>
</html>