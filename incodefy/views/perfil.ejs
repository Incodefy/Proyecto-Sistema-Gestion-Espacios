<!DOCTYPE html>
<html lang="<%= lng || 'es' %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('profile.title') %></title>
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/perfil.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  
  <%- include('partials/personalization-styles') %>

</head>
<body data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>">
  <div class="container-fluid">
    <div class="row">
      <%- include('navbar') %>

      <div class="main">
        <div class="top-header">
          <h1 class="page-title"><%= t('profile.header') %></h1>
          <p class="page-subtitle"><%= t('profile.subtitle') %></p>
        </div>

        <div class="row justify-content-center">
          <div class="col-12 col-md-8 col-lg-6">
            <div class="profile-card">
              
              <!-- Información del usuario -->
              <div class="user-info">
                <div class="user-avatar">
                  <i class="fas fa-user-circle"></i>
                </div>
                <div class="user-details">
                  <h3><%= user.nombre %></h3>
                  <p><%= user.email %></p>
                </div>
              </div>

              <!-- Formulario de personalización -->
              <form id="personalizationForm">
                <div class="form-section">
                  <h4><i class="fas fa-palette"></i> <%= t('profile.theme.title') %></h4>
                  <!-- Modo de tema -->
                  <div class="form-group">
                    <label><%= t('profile.theme.mode') %></label>
                    <div class="radio-group">
                      <input type="radio" id="light-mode" name="theme.mode" value="light" 
                             <%= (!personalization['theme.mode'] || personalization['theme.mode'] === 'light') ? 'checked' : '' %>>
                      <label class="radio-option" for="light-mode">
                        <i class="fas fa-sun"></i> <%= t('profile.theme.light') %>
                      </label>
                      <input type="radio" id="dark-mode" name="theme.mode" value="dark"
                             <%= personalization['theme.mode'] === 'dark' ? 'checked' : '' %>>
                      <label class="radio-option" for="dark-mode">
                        <i class="fas fa-moon"></i> <%= t('profile.theme.dark') %>
                      </label>
                    </div>
                  </div>
                  <!-- Color principal -->
                  <div class="form-group">
                    <label><%= t('profile.theme.primary_color') %></label>
                    <div class="color-group">
                      <% const colors = [
                        { value: '#1a3c7c', name: 'blue' },
                        { value: '#d53232ff', name: 'red' },
                        { value: '#059669', name: 'green' },
                        { value: '#7c3aed', name: 'purple' },
                        { value: '#ea580c', name: 'orange' }
                      ]; %>
                      <% colors.forEach(color => { %>
                        <div class="color-option-wrapper">
                          <input type="radio" 
                                 id="color-<%= color.value.replace('#', '') %>" 
                                 name="theme.primary_color" 
                                 value="<%= color.value %>" 
                                 <%= (!personalization['theme.primary_color'] && color.value === '#1a3c7c') || 
                                     personalization['theme.primary_color'] === color.value ? 'checked' : '' %>>
                          <label for="color-<%= color.value.replace('#', '') %>" class="color-option">
                            <span class="color-preview" style="background-color: <%= color.value %>"></span>
                            <span class="color-name"><%= t('colors.' + color.name) %></span>
                          </label>
                        </div>
                      <% }); %>
                    </div>
                  </div>
                </div>

                <!-- Selector de escala de fuente -->
                <div class="form-section">
                  <h4><i class="fas fa-text-height"></i> <%= t('profile.font.title') %></h4>
                  <div class="form-group">
                    <label><%= t('profile.font.scale') %></label>
                    <div class="radio-group">
                      <% 
                        const fontScales = [
                          { value: 'pequeno', label: 'small' },
                          { value: 'mediano', label: 'medium' },
                          { value: 'grande', label: 'large' }
                        ];
                        const currentScale = (personalization && personalization['font.scale']) || 'mediano';
                      %>
                      <% fontScales.forEach(scale => { %>
                        <input type="radio" 
                               id="font-<%= scale.value %>" 
                               name="font.scale" 
                               value="<%= scale.value %>"
                               <%= currentScale === scale.value ? 'checked' : '' %>>
                        <label class="radio-option" for="font-<%= scale.value %>">
                          <i class="fas fa-font" style="font-size: <%= scale.value === 'pequeno' ? '0.8em' : (scale.value === 'grande' ? '1.2em' : '1em') %>;"></i> 
                          <%= t('font_scales.' + scale.label) %>
                        </label>
                      <% }); %>
                    </div>
                  </div>
                </div>

                <!-- Idioma -->
                <div class="form-section">
                  <h4><i class="fas fa-globe"></i> <%= t('profile.language.title') %></h4>
                  <div class="form-group">
                    <label><%= t('profile.language.interface_language') %></label>
                    <select name="locale.language" class="form-select">
                      <option value="es" <%= (!personalization['locale.language'] || personalization['locale.language'] === 'es') ? 'selected' : '' %>>
                        🇪🇸 <%= t('languages.es') %>
                      </option>
                      <option value="en" <%= personalization['locale.language'] === 'en' ? 'selected' : '' %>>
                        🇺🇸 <%= t('languages.en') %>
                      </option>
                      <option value="ar" <%= personalization['locale.language'] === 'ar' ? 'selected' : '' %>>
                        ar <%= t('languages.ar') %>
                      </option>
                      <option value="bn" <%= personalization['locale.language'] === 'bn' ? 'selected' : '' %>>
                        bn <%= t('languages.bn') %>
                      </option>
                      <option value="de" <%= personalization['locale.language'] === 'de' ? 'selected' : '' %>>
                        de <%= t('languages.de') %>
                      </option>
                      <option value="fa" <%= personalization['locale.language'] === 'fa' ? 'selected' : '' %>>
                        fa <%= t('languages.fa') %>
                      </option>
                      <option value="fr" <%= personalization['locale.language'] === 'fr' ? 'selected' : '' %>>
                        fr <%= t('languages.fr') %>
                      </option>
                      <option value="hi" <%= personalization['locale.language'] === 'hi' ? 'selected' : '' %>>
                        hi <%= t('languages.hi') %>
                      </option>
                      <option value="it" <%= personalization['locale.language'] === 'it' ? 'selected' : '' %>>
                        it <%= t('languages.it') %>
                      </option>
                      <option value="ja" <%= personalization['locale.language'] === 'ja' ? 'selected' : '' %>>
                        ja <%= t('languages.ja') %>
                      </option>
                      <option value="jv" <%= personalization['locale.language'] === 'jv' ? 'selected' : '' %>>
                        jv <%= t('languages.jv') %>
                      </option>
                      <option value="ko" <%= personalization['locale.language'] === 'ko' ? 'selected' : '' %>>
                        ko <%= t('languages.ko') %>
                      </option>
                      <option value="mr" <%= personalization['locale.language'] === 'mr' ? 'selected' : '' %>>
                        mr <%= t('languages.mr') %>
                      </option>
                      <option value="nl" <%= personalization['locale.language'] === 'nl' ? 'selected' : '' %>>
                        nl <%= t('languages.nl') %>
                      </option>
                      <option value="pa" <%= personalization['locale.language'] === 'pa' ? 'selected' : '' %>>
                        pa <%= t('languages.pa') %>
                      </option>
                      <option value="pl" <%= personalization['locale.language'] === 'pl' ? 'selected' : '' %>>
                        pl <%= t('languages.pl') %>
                      </option>
                      <option value="pt" <%= personalization['locale.language'] === 'pt' ? 'selected' : '' %>>
                        pt <%= t('languages.pt') %>
                      </option>
                      <option value="ru" <%= personalization['locale.language'] === 'ru' ? 'selected' : '' %>>
                        ru <%= t('languages.ru') %>
                      </option>
                      <option value="ta" <%= personalization['locale.language'] === 'ta' ? 'selected' : '' %>>
                        ta <%= t('languages.ta') %>
                      </option>
                      <option value="te" <%= personalization['locale.language'] === 'te' ? 'selected' : '' %>>
                        te <%= t('languages.te') %>
                      </option>
                      <option value="th" <%= personalization['locale.language'] === 'th' ? 'selected' : '' %>>
                        🇹🇭 <%= t('languages.th') %>
                      </option>
                      <option value="tr" <%= personalization['locale.language'] === 'tr' ? 'selected' : '' %>>
                        tr <%= t('languages.tr') %>
                      </option>
                      <option value="ur" <%= personalization['locale.language'] === 'ur' ? 'selected' : '' %>>
                        ur <%= t('languages.ur') %>
                      </option>
                      <option value="vi" <%= personalization['locale.language'] === 'vi' ? 'selected' : '' %>>
                        vi <%= t('languages.vi') %>
                      </option>
                      <option value="zh" <%= personalization['locale.language'] === 'zh' ? 'selected' : '' %>>
                        zh <%= t('languages.zh') %>
                      </option>
                    </select>
                  </div>
                </div>

                <!-- Espacio de Trabajo -->
                <div class="fc">
                  <h4><i class="fas fa-layer-group"></i> <%= t('profile.workspace.title') %></h4>
                  <div class="fg form-group">
                    <label class="tl"><%= t('profile.workspace.active_group') %></label>
                    <div class="current-group-info" id="currentGroupInfo">
                      <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Cargando...</span>
                      </div>
                      <span class="ms-2"><%= t('profile.workspace.loading') %></span>
                    </div>
                    <button type="button" class="ch btn btn-outline-primary mt-2" id="changeGroupBtn">
                      <i class="fas fa-exchange-alt"></i> <%= t('profile.workspace.change_group') %>
                    </button>
                    <a href="/onboarding-espacios" class="ch btn btn-outline-success mt-2">
                      <i class="fas fa-th-large"></i> <%= t('profile.workspace.manage_spaces') %>
                    </a>
                  </div>
                </div>

                <!-- Botones de acción -->
                <div class="form-actions">
                  <button type="submit" id="saveBtn" class="btn btn-primary">
                    <i class="fas fa-save"></i> <%= t('profile.buttons.save') %>
                  </button>
                </div>

                <!-- Loader y mensajes -->
                <div id="loader" class="loader" style="display: none;">
                  <i class="fas fa-spinner fa-spin"></i> <%= t('profile.messages.saving') %>
                </div>
                <div id="message" class="message"></div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <%- include('footer') %>
    </div>
  </div>

  <!-- Modal para cambiar de grupo -->
  <div class="modal fade" id="changeGroupModal" tabindex="-1" aria-labelledby="changeGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="changeGroupModalLabel">
            <i class="fas fa-layer-group"></i> <%= t('profile.workspace.select_group') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="groupsListContainer">
            <div class="text-center py-4">
              <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando grupos...</span>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%= t('profile.buttons.cancel') %>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Variables globales
    let changeGroupModal = null;

    // Función para cargar el grupo activo actual
    async function loadActiveGroup() {
      const container = document.getElementById('currentGroupInfo');
      try {
        const response = await fetch('/api/espacios/grupo-activo');
        const data = await response.json();
        
        console.log('📊 Respuesta completa de grupo-activo:', data);
        console.log('📊 Estructura de grupo_activo:', data.grupo_activo);
        
        if (data.ok && data.grupo_activo) {
          const grupo = data.grupo_activo;
          
          // Log para ver todos los campos disponibles
          console.log('📋 Campos disponibles en grupo:', Object.keys(grupo));
          console.log('📋 Valor de nombre:', grupo.nombre);
          console.log('📋 Valor completo del grupo:', grupo);
          
          // Intentar obtener el nombre de diferentes formas
          const nombreGrupo = grupo.nombre || grupo.name || grupo.grupo_nombre || 'Sin nombre';
          
          const fechaCreacion = grupo.created_at ? 
            new Date(grupo.created_at).toLocaleDateString('es-CL', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            }) : 
            'Fecha no disponible';
          
          container.classList.add('loaded');
          container.innerHTML = `
            <div>
              <div class="current-group-name">${nombreGrupo}</div>
              <div class="current-group-date">
                <i class="fas fa-calendar"></i>
                Creado: ${fechaCreacion}
              </div>
            </div>
            <div>
              <span class="badge bg-success">Activo</span>
            </div>
          `;
        } else {
          container.innerHTML = `
            <div class="text-muted">
              <i class="fas fa-info-circle"></i> No tienes un grupo activo
            </div>
          `;
        }
      } catch (error) {
        console.error('❌ Error cargando grupo activo:', error);
        container.innerHTML = `
          <div class="text-danger">
            <i class="fas fa-exclamation-triangle"></i> Error al cargar grupo activo
          </div>
        `;
      }
    }

    // Función para cargar lista de grupos en el modal
    async function loadGroupsList() {
      const container = document.getElementById('groupsListContainer');
      
      // Mostrar loading
      container.innerHTML = `
        <div class="text-center py-4">
          <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando grupos...</span>
          </div>
        </div>
      `;
      
      try {
        // Cargar grupos y grupo activo en paralelo
        const [gruposRes, activoRes] = await Promise.all([
          fetch('/api/espacios/grupos-usuario'),
          fetch('/api/espacios/grupo-activo').catch(() => ({ ok: false }))
        ]);
        
        const gruposData = await gruposRes.json();
        const activoData = activoRes.ok ? await activoRes.json() : { ok: false };
        
        console.log('📋 Respuesta de grupos-usuario:', gruposData);
        console.log('📋 Grupos array:', gruposData.grupos);
        console.log('📋 Primer grupo (ejemplo):', gruposData.grupos?.[0]);
        
        const grupos = gruposData.grupos || [];
        const grupoActivoId = activoData.ok ? activoData.grupo_activo?.grupo_id : null;
        
        console.log('✅ Grupo activo ID:', grupoActivoId);
        console.log('✅ Tipo de grupoActivoId:', typeof grupoActivoId);
        
        if (grupos.length === 0) {
          container.innerHTML = `
            <div class="text-center text-muted py-4">
              <i class="fas fa-folder-open fa-3x mb-3"></i>
              <p>No tienes grupos disponibles</p>
              <a href="/onboarding-espacios" class="btn btn-primary">
                <i class="fas fa-plus"></i> Crear primer grupo
              </a>
            </div>
          `;
          return;
        }
        
        container.innerHTML = grupos.map((grupo, index) => {
          console.log(`🔍 Procesando grupo ${index}:`, {
            grupo_id: grupo.grupo_id,
            nombre: grupo.nombre,
            name: grupo.name,
            tipo_grupo_id: typeof grupo.grupo_id
          });
          
          const esActivo = String(grupo.grupo_id) === String(grupoActivoId);
          
          // Intentar obtener el nombre de diferentes formas
          const nombreGrupo = grupo.nombre || grupo.name || grupo.grupo_nombre || 'Sin nombre';
          
          const fechaCreacion = grupo.created_at ? 
            new Date(grupo.created_at).toLocaleDateString('es-CL', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            }) : 
            'Fecha no disponible';
          
          return `
            <div class="group-modal-item ${esActivo ? 'active' : ''}" 
                data-grupo-id="${grupo.grupo_id}"
                style="${esActivo ? 'cursor: default;' : 'cursor: pointer;'}">
              <div class="group-modal-info">
                <h6>${nombreGrupo}</h6>
                <small>
                  <i class="fas fa-calendar"></i>
                  ${fechaCreacion}
                </small>
              </div>
              ${esActivo ? 
                '<span class="group-modal-badge">Activo</span>' : 
                '<i class="fas fr fa-chevron-right text-muted"></i>'
              }
            </div>
          `;
        }).join('');
        
        // Event listeners para cada grupo
        document.querySelectorAll('.group-modal-item').forEach(item => {
          const grupoId = item.dataset.grupoId;
          const esActivo = String(grupoId) === String(grupoActivoId);
          
          if (!esActivo) {
            item.addEventListener('click', () => {
              changeActiveGroup(grupoId, item);
            });
          }
        });
        
      } catch (error) {
        console.error('❌ Error cargando grupos:', error);
        container.innerHTML = `
          <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i>
            Error al cargar los grupos. Por favor, intenta nuevamente.
          </div>
        `;
      }
    }

    // Función para cambiar el grupo activo
    async function changeActiveGroup(grupoId, itemElement) {
      const messageDiv = document.getElementById('message');
      
      // Deshabilitar el item mientras se procesa
      if (itemElement) {
        itemElement.style.pointerEvents = 'none';
        itemElement.style.opacity = '0.6';
        itemElement.innerHTML = `
          <div class="group-modal-info">
            <h6>Cambiando grupo...</h6>
            <small>
              <div class="spinner-border spinner-border-sm" role="status"></div>
              Por favor espera
            </small>
          </div>
        `;
      }
      
      try {
        const response = await fetch('/api/espacios/asignar-grupo', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ grupo_id: grupoId })
        });
        
        const data = await response.json();
        
        if (data.ok) {
          messageDiv.innerHTML = `
            <i class="fas fa-check-circle"></i> 
            Grupo cambiado exitosamente. Recargando página...
          `;
          messageDiv.className = 'message success';
          messageDiv.style.display = 'block';
          
          // Cerrar modal manualmente
          const modalElement = document.getElementById('changeGroupModal');
          modalElement.classList.remove('show');
          modalElement.style.display = 'none';
          document.body.classList.remove('modal-open');
          const backdrop = document.querySelector('.modal-backdrop');
          if (backdrop) backdrop.remove();
          
          // Recargar página
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          throw new Error(data.error || 'Error al cambiar de grupo');
        }
      } catch (error) {
        console.error('Error cambiando grupo:', error);
        
        messageDiv.innerHTML = `
          <i class="fas fa-exclamation-triangle"></i> 
          Error: ${error.message}
        `;
        messageDiv.className = 'message error';
        messageDiv.style.display = 'block';
        
        // Restaurar el item
        if (itemElement) {
          itemElement.style.pointerEvents = 'auto';
          itemElement.style.opacity = '1';
        }
        
        // Recargar lista de grupos
        setTimeout(() => {
          loadGroupsList();
        }, 2000);
      }
    }

    // Inicializar cuando el DOM esté listo
    document.addEventListener('DOMContentLoaded', function() {
      // Cargar grupo activo
      loadActiveGroup();
      
      // Inicializar modal (sin Bootstrap JS, usando atributos data)
      const modalElement = document.getElementById('changeGroupModal');
      
      // Event listener para abrir modal
      document.getElementById('changeGroupBtn').addEventListener('click', () => {
        modalElement.classList.add('show');
        modalElement.style.display = 'block';
        document.body.classList.add('modal-open');
        
        // Agregar backdrop
        const backdrop = document.createElement('div');
        backdrop.className = 'modal-backdrop fade show';
        document.body.appendChild(backdrop);
        
        // Cargar grupos
        loadGroupsList();
      });
      
      // Event listeners para cerrar modal
      const closeButtons = modalElement.querySelectorAll('[data-bs-dismiss="modal"]');
      closeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          modalElement.classList.remove('show');
          modalElement.style.display = 'none';
          document.body.classList.remove('modal-open');
          const backdrop = document.querySelector('.modal-backdrop');
          if (backdrop) backdrop.remove();
        });
      });
      
      // Cerrar al hacer click fuera del modal
      modalElement.addEventListener('click', (e) => {
        if (e.target === modalElement) {
          modalElement.classList.remove('show');
          modalElement.style.display = 'none';
          document.body.classList.remove('modal-open');
          const backdrop = document.querySelector('.modal-backdrop');
          if (backdrop) backdrop.remove();
        }
      });
    });

    // Evento principal - Submit del formulario (guardar cambios)
    document.getElementById('personalizationForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const loader = document.getElementById('loader');
      const saveBtn = document.getElementById('saveBtn');
      const messageDiv = document.getElementById('message');

      // Mostrar loader y deshabilitar botón
      loader.style.display = 'block';
      saveBtn.disabled = true;
      messageDiv.style.display = 'none';

      try {
        const formData = new FormData(this);
        const parameters = Object.fromEntries(formData.entries());
        
        const response = await fetch('/api/personalization', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ parameters })
        });

        const result = await response.json();
        if (!result.ok) {
          throw new Error(result.error || '<%= t("profile.messages.save_error") %>');
        }

        // Mostrar mensaje de éxito y recargar la página para aplicar cambios
        messageDiv.innerHTML = `<i class="fas fa-check-circle"></i> <%= t("profile.messages.save_success") %>`;
        messageDiv.className = 'message success';
        messageDiv.style.display = 'block';

        setTimeout(() => {
          window.location.reload();
        }, 1500);

      } catch (error) {
        messageDiv.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Error: ${error.message}`;
        messageDiv.className = 'message error';
        messageDiv.style.display = 'block';
        loader.style.display = 'none';
        saveBtn.disabled = false;
      }
    });
  </script>
</body>
</html>