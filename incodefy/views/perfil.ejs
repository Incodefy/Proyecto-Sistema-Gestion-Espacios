<!DOCTYPE html>
<html lang="<%= lng || 'es' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Configuración de perfil y preferencias de usuario">
  <title><%= t('profile.title') %></title>
  
  <!-- Token CSRF para peticiones AJAX -->
  <meta name="csrf-token" content="<%= csrfToken %>">
  
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/perfil.css">
  <link rel="stylesheet" href="/css/color-classes.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/notifications.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/fontawesome/css/all.min.css" rel="stylesheet">
  
  <%- include('partials/personalization-styles') %>

</head>
<body data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>">
  <div class="container-fluid">
    <div class="row">
      <%- include('navbar') %>

      <main class="main" role="main" aria-label="Contenido principal">
        <header class="top-header">
          <h1 class="page-title"><%= t('profile.header') %></h1>
          <p class="page-subtitle"><%= t('profile.subtitle') %></p>
        </header>

        <div class="row justify-content-center">
          <div class="col-12 col-md-8 col-lg-6">
            <section class="profile-card" aria-labelledby="profile-heading">
              
              <!-- Información del usuario -->
              <div class="user-info">
                <div class="user-avatar" aria-hidden="true">
                  <i class="fas fa-user-circle"></i>
                </div>
                <div class="user-details">
                  <h2 id="profile-heading"><%= user.nombre %></h2>
                  <p><%= user.email %></p>
                </div>
              </div>

              <!-- Formulario de personalización -->
              <form id="personalizationForm" aria-label="Configuración de personalización">
                <fieldset class="form-section">
                  <legend><h3><i class="fas fa-palette" aria-hidden="true"></i> <%= t('profile.theme.title') %></h3></legend>
                  <!-- Modo de tema -->
                  <div class="form-group">
                    <label id="theme-mode-label"><%= t('profile.theme.mode') %></label>
                    <div class="radio-group" role="radiogroup" aria-labelledby="theme-mode-label">
                      <input type="radio" id="light-mode" name="theme.mode" value="light" 
                             <%= (!personalization['theme.mode'] || personalization['theme.mode'] === 'light') ? 'checked' : '' %>>
                      <label class="radio-option" for="light-mode">
                        <i class="fas fa-sun" aria-hidden="true"></i> <%= t('profile.theme.light') %>
                      </label>
                      <input type="radio" id="dark-mode" name="theme.mode" value="dark"
                             <%= personalization['theme.mode'] === 'dark' ? 'checked' : '' %>>
                      <label class="radio-option" for="dark-mode">
                        <i class="fas fa-moon" aria-hidden="true"></i> <%= t('profile.theme.dark') %>
                      </label>
                    </div>
                  </div>
                  
                  <!-- Selector de color mejorado -->
                  <div class="form-group">
                    <label for="selectedColor"><%= t('profile.theme.primary_color') %></label>
                    
                    <!-- Vista previa del color actual -->
                    <div class="color-preview-current" id="colorPreviewCurrent" aria-live="polite">
                      <div class="preview-box" 
                           id="previewBox" 
                           role="img"
                           :aria-label="<%= t('profile.color_picker.preview_aria') %>"
                           data-preview-color="<%= personalization['theme.primary_color'] || '#1a3c7c' %>"></div>
                      <div class="preview-info">
                        <span class="preview-label"><%= t('profile.color_picker.current_color') %></span>
                        <span class="preview-name" id="previewName"><%= t('colors.blue') %></span>
                        <span class="preview-hex" id="previewHex"><%= personalization['theme.primary_color'] || '#1a3c7c' %></span>
                      </div>
                    </div>

                    <!-- Input oculto para el valor -->
                    <input type="hidden" name="theme.primary_color" id="selectedColor" value="<%= personalization['theme.primary_color'] || '#1a3c7c' %>">
                    
                    <!-- Botón para abrir modal -->
                    <button type="button" 
                            class="btn-open-color-picker" 
                            id="openColorPicker"
                            :aria-label="<%= t('profile.color_picker.open_picker_aria') %>"
                            aria-haspopup="dialog">
                      <i class="fas fa-palette" aria-hidden="true"></i>
                      <span><%= t('profile.color_picker.explore_colors') %></span>
                      <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </button>
                  </div>
                </fieldset>

                <!-- Selector de escala de fuente -->
                <fieldset class="form-section">
                  <legend><h3><i class="fas fa-text-height" aria-hidden="true"></i> <%= t('profile.font.title') %></h3></legend>
                  <div class="form-group">
                    <label id="font-scale-label"><%= t('profile.font.scale') %></label>
                    <div class="radio-group" role="radiogroup" aria-labelledby="font-scale-label">
                      <%
                        const fontScales = [
                          { value: 'pequeno', label: 'small' },
                          { value: 'mediano', label: 'medium' },
                          { value: 'grande', label: 'large' }
                        ];
                        const currentScale = (personalization && personalization['font.scale']) || 'mediano';
                      %>
                      <% fontScales.forEach(scale => { %>
                        <input type="radio" 
                               id="font-<%= scale.value %>" 
                               name="font.scale" 
                               value="<%= scale.value %>"
                               <%= currentScale === scale.value ? 'checked' : '' %>>
                        <label class="radio-option" for="font-<%= scale.value %>">
                          <i class="fas fa-font scale-preview" data-scale="<%= scale.value %>"></i> 
                          <%= t('font_scales.' + scale.label) %>
                        </label>
                      <% }); %>
                    </div>
                  </div>
                </fieldset>

                <!-- Idioma -->
                <fieldset class="form-section">
                  <legend><h3><i class="fas fa-globe" aria-hidden="true"></i> <%= t('profile.language.title') %></h3></legend>
                  <div class="form-group">
                    <label for="locale-language"><%= t('profile.language.interface_language') %></label>
                    <select name="locale.language" id="locale-language" class="form-select" aria-label="Seleccionar idioma">
                      <option value="es" <%= (!personalization['locale.language'] || personalization['locale.language'] === 'es') ? 'selected' : '' %>>
                        🇪🇸 <%= t('languages.es') %>
                      </option>
                      <option value="en" <%= personalization['locale.language'] === 'en' ? 'selected' : '' %>>
                        🇺🇸 <%= t('languages.en') %>
                      </option>
                      <option value="ar" <%= personalization['locale.language'] === 'ar' ? 'selected' : '' %>>
                        <%= t('languages.ar') %>
                      </option>
                      <option value="bn" <%= personalization['locale.language'] === 'bn' ? 'selected' : '' %>>
                        <%= t('languages.bn') %>
                      </option>
                      <option value="de" <%= personalization['locale.language'] === 'de' ? 'selected' : '' %>>
                        🇩🇪 <%= t('languages.de') %>
                      </option>
                      <option value="fa" <%= personalization['locale.language'] === 'fa' ? 'selected' : '' %>>
                        <%= t('languages.fa') %>
                      </option>
                      <option value="fr" <%= personalization['locale.language'] === 'fr' ? 'selected' : '' %>>
                        🇫🇷 <%= t('languages.fr') %>
                      </option>
                      <option value="hi" <%= personalization['locale.language'] === 'hi' ? 'selected' : '' %>>
                        <%= t('languages.hi') %>
                      </option>
                      <option value="it" <%= personalization['locale.language'] === 'it' ? 'selected' : '' %>>
                        🇮🇹 <%= t('languages.it') %>
                      </option>
                      <option value="ja" <%= personalization['locale.language'] === 'ja' ? 'selected' : '' %>>
                        🇯🇵 <%= t('languages.ja') %>
                      </option>
                      <option value="jv" <%= personalization['locale.language'] === 'jv' ? 'selected' : '' %>>
                        <%= t('languages.jv') %>
                      </option>
                      <option value="ko" <%= personalization['locale.language'] === 'ko' ? 'selected' : '' %>>
                        🇰🇷 <%= t('languages.ko') %>
                      </option>
                      <option value="mr" <%= personalization['locale.language'] === 'mr' ? 'selected' : '' %>>
                        <%= t('languages.mr') %>
                      </option>
                      <option value="nl" <%= personalization['locale.language'] === 'nl' ? 'selected' : '' %>>
                        🇳🇱 <%= t('languages.nl') %>
                      </option>
                      <option value="pa" <%= personalization['locale.language'] === 'pa' ? 'selected' : '' %>>
                        <%= t('languages.pa') %>
                      </option>
                      <option value="pl" <%= personalization['locale.language'] === 'pl' ? 'selected' : '' %>>
                        🇵🇱 <%= t('languages.pl') %>
                      </option>
                      <option value="pt" <%= personalization['locale.language'] === 'pt' ? 'selected' : '' %>>
                        🇵🇹 <%= t('languages.pt') %>
                      </option>
                      <option value="ru" <%= personalization['locale.language'] === 'ru' ? 'selected' : '' %>>
                        🇷🇺 <%= t('languages.ru') %>
                      </option>
                      <option value="ta" <%= personalization['locale.language'] === 'ta' ? 'selected' : '' %>>
                        <%= t('languages.ta') %>
                      </option>
                      <option value="te" <%= personalization['locale.language'] === 'te' ? 'selected' : '' %>>
                        <%= t('languages.te') %>
                      </option>
                      <option value="th" <%= personalization['locale.language'] === 'th' ? 'selected' : '' %>>
                        🇹🇭 <%= t('languages.th') %>
                      </option>
                      <option value="tr" <%= personalization['locale.language'] === 'tr' ? 'selected' : '' %>>
                        🇹🇷 <%= t('languages.tr') %>
                      </option>
                      <option value="ur" <%= personalization['locale.language'] === 'ur' ? 'selected' : '' %>>
                        <%= t('languages.ur') %>
                      </option>
                      <option value="vi" <%= personalization['locale.language'] === 'vi' ? 'selected' : '' %>>
                        🇻🇳 <%= t('languages.vi') %>
                      </option>
                      <option value="zh" <%= personalization['locale.language'] === 'zh' ? 'selected' : '' %>>
                        🇨🇳 <%= t('languages.zh') %>
                      </option>
                    </select>
                  </div>
                </fieldset>

                <!-- Espacio de Trabajo -->
                <fieldset class="form-section">
                  <legend><h3><i class="fas fa-layer-group" aria-hidden="true"></i> <%= t('profile.workspace.title') %></h3></legend>
                  <div class="form-group">
                    <label for="currentGroupInfo"><%= t('profile.workspace.active_group') %></label>
                    <div class="current-group-info" id="currentGroupInfo" role="status" aria-live="polite">
                      <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Cargando...</span>
                      </div>
                      <span class="ms-2"><%= t('profile.workspace.loading') %></span>
                    </div>
                    <button type="button" class="btn btn-outline-primary mt-2" id="changeGroupBtn">
                      <i class="fas fa-exchange-alt" aria-hidden="true"></i> <%= t('profile.workspace.change_group') %>
                    </button>
                    <a href="/onboarding-espacios" class="btn btn-outline-success mt-2">
                      <i class="fas fa-th-large" aria-hidden="true"></i> <%= t('profile.workspace.manage_spaces') %>
                    </a>
                  </div>
                </fieldset>
              </form>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  <%- include('footer') %>

  <!-- Modal para cambiar de grupo -->
  <div class="modal fade" id="changeGroupModal" tabindex="-1" aria-labelledby="changeGroupModalLabel">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="changeGroupModalLabel">
            <i class="fas fa-layer-group"></i> <%= t('profile.workspace.select_group') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="groupsList">
            <div class="loading d-none">
              <div class="text-center py-4">
                <div class="spinner-border" role="status">
                  <span class="visually-hidden"><%= t('profile.workspace.loading_groups') %></span>
                </div>
              </div>
            </div>
            <div class="error d-none text-danger text-center py-3"></div>
            <div class="groups-list"></div>
            <div id="groupChangeMessage" class="d-none mt-3"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de selector de colores -->
  <div class="modal fade d-none" id="colorPickerModal" tabindex="-1" aria-labelledby="colorPickerModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="colorPickerModalLabel">
            <i class="fas fa-palette"></i> <%= t('profile.color_picker.select_color') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <!-- Vista previa grande -->
          <div class="color-preview-large" id="colorPreviewLarge">
            <div class="preview-large-box" id="previewLargeBox" data-preview-color="<%= personalization['theme.primary_color'] || '#1a3c7c' %>"></div>
            <div class="preview-large-info">
              <span class="preview-large-name" id="previewLargeName"><%= t('profile.color_picker.select_a_color') %></span>
              <span class="preview-large-hex" id="previewLargeHex"><%= personalization['theme.primary_color'] || '#1a3c7c' %></span>
            </div>
          </div>          
          <!-- Búsqueda de colores -->
          <div class="color-search-container">
            <input type="text" 
                   id="colorSearch" 
                   class="color-search-input" 
                   :placeholder="<%= t('profile.color_picker.search_placeholder') %>">
            <i class="fas fa-search color-search-icon"></i>
          </div>

          <!-- Colores Populares -->
          <div class="color-category">
            <h6 class="category-title">
              <i class="fas fa-star"></i> <%= t('profile.color_picker.categories.popular') %>
            </h6>
            <div class="color-grid" id="popularColors"></div>
          </div>

          <!-- Colores Vibrantes -->
          <div class="color-category">
            <h6 class="category-title">
              <i class="fas fa-bolt"></i> <%= t('profile.color_picker.categories.vibrant') %>
            </h6>
            <div class="color-grid" id="vibrantColors"></div>
          </div>

          <!-- Colores Pasteles -->
          <div class="color-category">
            <h6 class="category-title">
              <i class="fas fa-cloud"></i> <%= t('profile.color_picker.categories.pastel') %>
            </h6>
            <div class="color-grid" id="pastelColors"></div>
          </div>

          <!-- Colores Oscuros -->
          <div class="color-category">
            <h6 class="category-title">
              <i class="fas fa-moon"></i> <%= t('profile.color_picker.categories.dark') %>
            </h6>
            <div class="color-grid" id="darkColors"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%= t('profile.buttons.cancel') %>
          </button>
          <button type="button" class="btn btn-secondary" id="confirmColorBtn">
            <%= t('profile.color_picker.apply_color') %>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Script externo para perfil -->
  <script nonce="<%= cspNonce %>">
    // Traducciones de workspace para uso en JavaScript
    window.WORKSPACE_TRANSLATIONS = {
      active_badge: "<%= t('profile.workspace.active_badge') %>",
      select_badge: "<%= t('profile.workspace.select_badge') %>"
    };
    
    // Pasar traducciones de nombres de colores al cliente
    window.COLOR_TRANSLATIONS = {
      "Azul": "<%= t('profile.color_picker.color_names.Azul') %>",
      "Rojo": "<%= t('profile.color_picker.color_names.Rojo') %>",
      "Verde": "<%= t('profile.color_picker.color_names.Verde') %>",
      "Púrpura": "<%= t('profile.color_picker.color_names.Púrpura') %>",
      "Naranja": "<%= t('profile.color_picker.color_names.Naranja') %>",
      "Rojo Vibrante": "<%= t('profile.color_picker.color_names.Rojo Vibrante') %>",
      "Naranja Intenso": "<%= t('profile.color_picker.color_names.Naranja Intenso') %>",
      "Ámbar": "<%= t('profile.color_picker.color_names.Ámbar') %>",
      "Lima": "<%= t('profile.color_picker.color_names.Lima') %>",
      "Esmeralda": "<%= t('profile.color_picker.color_names.Esmeralda') %>",
      "Cian": "<%= t('profile.color_picker.color_names.Cian') %>",
      "Azul Rey": "<%= t('profile.color_picker.color_names.Azul Rey') %>",
      "Violeta": "<%= t('profile.color_picker.color_names.Violeta') %>",
      "Rosa Fucsia": "<%= t('profile.color_picker.color_names.Rosa Fucsia') %>",
      "Rosa Intenso": "<%= t('profile.color_picker.color_names.Rosa Intenso') %>",
      "Rosa Pastel": "<%= t('profile.color_picker.color_names.Rosa Pastel') %>",
      "Melocotón": "<%= t('profile.color_picker.color_names.Melocotón') %>",
      "Amarillo Suave": "<%= t('profile.color_picker.color_names.Amarillo Suave') %>",
      "Lima Pastel": "<%= t('profile.color_picker.color_names.Lima Pastel') %>",
      "Verde Menta": "<%= t('profile.color_picker.color_names.Verde Menta') %>",
      "Celeste": "<%= t('profile.color_picker.color_names.Celeste') %>",
      "Azul Cielo": "<%= t('profile.color_picker.color_names.Azul Cielo') %>",
      "Lavanda": "<%= t('profile.color_picker.color_names.Lavanda') %>",
      "Rosa Claro": "<%= t('profile.color_picker.color_names.Rosa Claro') %>",
      "Coral Suave": "<%= t('profile.color_picker.color_names.Coral Suave') %>",
      "Pizarra": "<%= t('profile.color_picker.color_names.Pizarra') %>",
      "Azul Marino": "<%= t('profile.color_picker.color_names.Azul Marino') %>",
      "Rosa Oscuro": "<%= t('profile.color_picker.color_names.Rosa Oscuro') %>",
      "Púrpura Oscuro": "<%= t('profile.color_picker.color_names.Púrpura Oscuro') %>",
      "Marrón": "<%= t('profile.color_picker.color_names.Marrón') %>",
      "Verde Oscuro": "<%= t('profile.color_picker.color_names.Verde Oscuro') %>",
      "Verde Azulado": "<%= t('profile.color_picker.color_names.Verde Azulado') %>",
      "Azul Profundo": "<%= t('profile.color_picker.color_names.Azul Profundo') %>",
      "Índigo Oscuro": "<%= t('profile.color_picker.color_names.Índigo Oscuro') %>",
      "Carmesí": "<%= t('profile.color_picker.color_names.Carmesí') %>"
    };
  </script>
  <script src="/js/color-picker.js?v=<%= Date.now() %>"></script>
  <script src="/js/perfil.js?v=<%= Date.now() %>"></script>
  <script src="/js/notifications.js?v=<%= Date.now() %>"></script>
  <script nonce="<%= cspNonce %>">
    window.notificationManager = new NotificationManager();
  </script>
  
  <!-- Protección CSRF automática -->
  <script src="/js/csrf-helper.js?v=<%= Date.now() %>"></script>
  
  <!-- Protección de sesión: Previene acceso después de logout -->
  <script src="/js/session-guard.js?v=<%= Date.now() %>"></script>
  
  <!-- Autenticación: Interceptor y renovación automática de tokens -->
  <script src="/js/auth-interceptor.js?v=<%= Date.now() %>"></script>
  <script src="/js/token-manager.js?v=<%= Date.now() %>"></script>
</body>
</html>