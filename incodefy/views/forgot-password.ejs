<!DOCTYPE html>
<html lang="<%= i18n?.language || 'es' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Recuperar contraseña - Sistema de Gestión Hospitalaria">
  <title>Recuperar Contraseña</title>
  
  <meta name="csrf-token" content="<%= csrfToken %>">
  
  <!-- Resource Hints para optimización -->
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  
  <!-- Preload recursos críticos -->
  <link rel="preload" href="/css/forgot-password.css?v=<%= Date.now() %>" as="style">
  <link rel="preload" href="/fontawesome/css/all.min.css?v=<%= Date.now() %>" as="style">
  <link rel="preload" href="/js/forgot-password.js?v=<%= Date.now() %>" as="script">
  
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  
  <!-- Cargar CSS de forma SINCRÓNICA -->
  <link rel="stylesheet" href="/css/forgot-password.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="/fontawesome/css/all.min.css?v=<%= Date.now() %>">
  
  <!-- Utility classes para animaciones CSP-compliant -->
  <style nonce="<%= cspNonce %>">
    .d-none{display:none!important}
    .d-block{display:block!important}
    .fade-in{animation:fadeIn .3s ease-in}
    .fade-out{animation:fadeOut .3s ease-out}
    @keyframes fadeIn{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
    @keyframes fadeOut{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-10px)}}
  </style>
</head>
<body>
<div class="wrapper">
  <div class="login-box">
    <!-- PASO 1: Solicitar email -->
    <div id="step1" class="step-container">
      <form method="POST" action="/auth/forgot-password" id="forgotPasswordForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <h2>Recuperar Contraseña</h2>
        <p class="subtitle">Ingresa tu correo electrónico y te enviaremos un código de verificación</p>

        <% if (error_msg && error_msg.length) { %>
          <div class="messages-container" role="alert" aria-live="assertive">
            <% error_msg.forEach(msg => { %>
              <div class="alert alert-error fade-in">
                <i class="fa-solid fa-exclamation-circle" aria-hidden="true"></i>
                <span><%= msg %></span>
              </div>
            <% }) %>
          </div>
        <% } %>

        <div class="input-box">
          <input type="email" 
                 name="correo" 
                 id="email" 
                 required
                 autocomplete="email"
                 aria-required="true"
                 aria-invalid="false"
                 placeholder="Correo electrónico"
                 value="">
          <span class="icon" aria-hidden="true"><i class="fa-solid fa-envelope"></i></span>
          <div class="error-message" id="email-error" role="alert" aria-live="polite"></div>
        </div>

        <button type="submit" id="sendCodeButton">
          <span class="button-text">Enviar código</span>
          <div class="spinner d-none" id="spinner1">
            <i class="fa-solid fa-spinner fa-spin"></i>
          </div>
        </button>

        <div class="register-link">
          ¿Recordaste tu contraseña? <a href="/login">Iniciar sesión</a>
        </div>
      </form>
    </div>

    <!-- PASO 2: Verificar código solamente -->
    <div id="step2" class="step-container d-none">
      <form id="verifyCodeForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" id="hiddenEmail" value="">
        
        <h2>Verificar Código</h2>
        <p class="subtitle">Ingresa el código de 6 dígitos que enviamos a tu correo</p>

        <!-- Nota informativa sobre spam -->
        <p class="spam-notice">
          <strong>Nota:</strong> Si no encuentras el correo, revisa tu carpeta de <strong>Spam</strong>. El código expira en 15 minutos.
        </p>

        <div id="step2Messages" class="messages-container d-none" role="alert" aria-live="assertive"></div>

        <div class="input-box">
          <input type="text" 
                 name="codigo" 
                 id="verificationCode" 
                 required
                 autocomplete="off"
                 placeholder="Código de verificación"
                 maxlength="6"
                 pattern="[0-9]{6}">
          <span class="icon" aria-hidden="true"><i class="fa-solid fa-key"></i></span>
          <div class="error-message" id="code-error" role="alert" aria-live="polite"></div>
        </div>

        <button type="submit" id="verifyCodeButton">
          <span class="button-text">Verificar código</span>
          <div class="spinner d-none" id="spinner2">
            <i class="fa-solid fa-spinner fa-spin"></i>
          </div>
        </button>

        <div class="register-link">
          <a href="#" id="backToStep1">← Volver a solicitar código</a>
        </div>
      </form>
    </div>

    <!-- PASO 3: Ingresar nueva contraseña -->
    <div id="step3" class="step-container d-none">
      <form method="POST" action="/auth/reset-password" id="resetPasswordForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="correo" id="hiddenEmail2" value="">
        <input type="hidden" name="codigo" id="hiddenCode" value="">
        
        <h2>Nueva Contraseña</h2>
        <p class="subtitle">Ingresa tu nueva contraseña</p>

        <div id="step3Messages" class="messages-container d-none" role="alert" aria-live="assertive"></div>

        <div class="input-box">
          <input type="password" 
                 name="nuevaPassword" 
                 id="newPassword" 
                 required
                 placeholder="Nueva contraseña">
          <span class="icon">
            <i class="fa-solid fa-eye" id="toggleNewPassword" title="Mostrar contraseña"></i>
          </span>
          <div class="error-message" id="newPassword-error"></div>
        </div>

        <div class="input-box">
          <input type="password" 
                 name="confirmarPassword" 
                 id="confirmPassword" 
                 required
                 placeholder="Confirmar contraseña">
          <span class="icon">
            <i class="fa-solid fa-eye" id="toggleConfirmPassword" title="Mostrar contraseña"></i>
          </span>
          <div class="error-message" id="confirmPassword-error"></div>
        </div>

        <div class="password-requirements">
          <div class="requirement-title">La contraseña debe contener:</div>
          <div class="requirement" data-requirement="length">
            <i class="fa-solid fa-circle"></i>
            <span>Al menos 8 caracteres</span>
          </div>
          <div class="requirement" data-requirement="uppercase">
            <i class="fa-solid fa-circle"></i>
            <span>Una letra mayúscula</span>
          </div>
          <div class="requirement" data-requirement="lowercase">
            <i class="fa-solid fa-circle"></i>
            <span>Una letra minúscula</span>
          </div>
          <div class="requirement" data-requirement="number">
            <i class="fa-solid fa-circle"></i>
            <span>Un número</span>
          </div>
          <div class="requirement" data-requirement="special">
            <i class="fa-solid fa-circle"></i>
            <span>Un carácter especial</span>
          </div>
        </div>

        <button type="submit" id="resetPasswordButton">
          <span class="button-text">Restablecer contraseña</span>
          <div class="spinner d-none" id="spinner3">
            <i class="fa-solid fa-spinner fa-spin"></i>
          </div>
        </button>
      </form>
    </div>
  </div>
</div>

<script src="/js/csrf-helper.js?v=<%= Date.now() %>"></script>
<script src="/js/forgot-password.js?v=<%= Date.now() %>" defer></script>
</body>
</html>