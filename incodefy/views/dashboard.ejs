<!DOCTYPE html>
<html lang="<%= i18n?.language || 'es' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Panel de control - Sistema de Gestión Hospitalaria">
    <meta name="robots" content="index, follow">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= t('dashboard.title') %> - Incodefy</title>
    
    <!-- Preconnect para recursos externos (mejora latencia DNS/TLS) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    
    <!-- CSS crítico - carga normal (bloquea render pero es necesario) -->
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    
    <!-- CSS no crítico - carga asíncrona sin inline handlers -->
    <link rel="stylesheet" href="/css/footer.css" media="print" id="footer-css">
    <link rel="stylesheet" href="/css/notifications.css" media="print" id="notifications-css">
    <noscript>
        <link rel="stylesheet" href="/css/footer.css">
        <link rel="stylesheet" href="/css/notifications.css">
    </noscript>
    
    <!-- Bootstrap y FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/fontawesome/css/all.min.css" rel="stylesheet">

    <!-- El bloque <style> anterior se reemplaza por esta única línea -->
    <%- include('partials/personalization-styles') %>
    
    <!-- Script para carga asíncrona de CSS (compatible con CSP) -->
    <script nonce="<%= cspNonce %>">
        // Cargar CSS no crítico después del load
        (function(){
            var footerCSS = document.getElementById('footer-css');
            var notifCSS = document.getElementById('notifications-css');
            
            function loadCSS(link) {
                if (link) {
                    link.addEventListener('load', function() {
                        this.media = 'all';
                    });
                    // Fallback si el evento load no dispara
                    if (link.sheet) {
                        link.media = 'all';
                    }
                }
            }
            
            loadCSS(footerCSS);
            loadCSS(notifCSS);
        })();
    </script>

</head>
<!-- Se añade el atributo data-theme para que funcione el modo oscuro/claro -->
