                <!-- KPIs -->
                <div class="dashboard-section-title-container dashboard-animate-on-load" style="animation-delay: 100ms;" nonce="<%= cspNonce %>">
                    <h2 class="dashboard-section-title"><%= t('dashboard.kpi.title') %></h2>
