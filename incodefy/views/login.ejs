<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('login.title') %></title>
  
  <meta name="csrf-token" content="<%= csrfToken %>">
  
  <!-- Resource Hints para optimización -->
  <link rel="dns-prefetch" href="//cdn.jsdelivr.net">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  
  <!-- Preload recursos críticos -->
  <link rel="preload" href="/css/login.css" as="style">
  <link rel="preload" href="/fontawesome/css/all.min.css" as="style">
  <link rel="preload" href="/js/login.js" as="script">
  
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  
  <!-- CSS crítico inline para First Contentful Paint -->
  <style nonce="<%= cspNonce %>">
    *{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}
    body{margin:0;overflow-x:hidden}
    .wrapper{min-height:100vh;display:flex;justify-content:center;align-items:center;padding:2rem;position:relative;background:#0a1628;overflow:hidden}
    .login-box{width:100%;max-width:450px;position:relative;z-index:10;background:rgba(15,23,42,.85);backdrop-filter:blur(20px);border-radius:24px;padding:3rem;box-shadow:0 8px 32px rgba(0,0,0,.3),0 0 0 1px rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.1)}
    .login-box h2{font-size:2rem;color:#fff;margin-bottom:2rem;text-align:center;font-weight:700}
  </style>
  
  <!-- CSS crítico con media print para cargar async (sin onload inline) -->
  <link rel="stylesheet" href="/css/login.css" media="print" id="login-css">
  <noscript><link rel="stylesheet" href="/css/login.css"></noscript>
  
  <!-- Font Awesome con defer (sin onload inline) -->
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" media="print" id="fontawesome-css">
  <noscript><link rel="stylesheet" href="/fontawesome/css/all.min.css"></noscript>
  
  <!-- Async CSS loader script -->
  <script nonce="<%= cspNonce %>">
    // Cargar CSS de forma async (CSP-compliant)
    var loginCss = document.getElementById('login-css');
    var fontawesomeCss = document.getElementById('fontawesome-css');
    if (loginCss) {
      loginCss.media = 'all';
    }
    if (fontawesomeCss) {
      fontawesomeCss.media = 'all';
    }
  </script>
</head>
<body>
<div class="wrapper">
  <div class="login-box">
    <form method="POST" action="/login" id="loginForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <% if (typeof redirect !== 'undefined' && redirect) { %>
        <input type="hidden" name="redirect" value="<%= redirect %>">
      <% } %>
      
      <h2><%= t('login.title') %></h2>

      <% if (error_msg && error_msg.length) { %>
        <div class="messages-container">
          <% error_msg.forEach(msg => { %>
            <div class="alert alert-error fade-in">
              <i class="fa-solid fa-exclamation-circle"></i>
              <%= msg %>
            </div>
          <% }) %>
        </div>
      <% } %>
      
      <div id="logoutMessage" class="messages-container d-none">
        <div class="alert alert-success fade-in">
          <i class="fa-solid fa-check-circle"></i>
          Has cerrado sesión correctamente
        </div>
      </div>

      <div class="input-box">
        <span class="icon"><i class="fa-solid fa-user"></i></span>
        <input type="email" name="correo" id="email" required
               value="<%= form_data ? form_data.correo : '' %>"
               class="<%= form_errors && form_errors.email ? 'error' : '' %>">
        <label><%= t('login.email') %></label>
        <div class="error-message" id="email-error"></div>
      </div>

      <div class="input-box">
        <span class="icon">
          <i class="fa-solid fa-eye" id="togglePassword" title="<%= t('login.show_password') %>"></i>
        </span>
        <input type="password" name="password" id="password" required
               class="<%= form_errors && form_errors.password ? 'error' : '' %>">
        <label><%= t('login.password') %></label>
        <div class="error-message" id="password-error"></div>
      </div>

      <div class="remember-forgot">
        <a href="javascript:void(0);" data-action="show-forgot-password"><%= t('login.forgot_password') %></a>
      </div>

      <button type="submit" id="loginButton">
        <span class="button-text"><%= t('login.login_button') %></span>
        <div class="spinner d-none" id="spinner">
          <i class="fa-solid fa-spinner fa-spin"></i>
        </div>
      </button>

      <div class="register-link">
        ¿No tienes cuenta? <a href="/auth/signup">Créala aquí</a>
      </div>
    </form>
  </div>
</div>

<script src="/js/csrf-helper.js"></script>

<script nonce="<%= cspNonce %>">
  // Limpiar almacenamiento local al cargar login
  try {
    localStorage.clear();
    sessionStorage.clear();
    console.log('✅ Almacenamiento local limpiado');
  } catch (e) {
    console.warn('⚠️ No se pudo limpiar almacenamiento:', e);
  }

  // Manejar mensaje de logout desde URL
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('logout') === 'true') {
    const logoutMsg = document.getElementById('logoutMessage');
    if (logoutMsg) {
      logoutMsg.classList.remove('d-none');
      
      const newUrl = window.location.pathname + (urlParams.get('redirect') ? '?redirect=' + urlParams.get('redirect') : '');
      window.history.replaceState({}, '', newUrl);
      
      setTimeout(() => {
        logoutMsg.classList.add('d-none');
      }, 5000);
    }
  }
</script>
<script src="/js/login.js" defer></script>
</body>
</html>