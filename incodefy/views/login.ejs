<!DOCTYPE html>
<html lang="<%= i18n?.language || 'es' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Inicio de sesión - Sistema de Gestión Hospitalaria">
  <title><%= t('login.title') %></title>
  
  <meta name="csrf-token" content="<%= csrfToken %>">
  
  <!-- Resource Hints para optimización -->
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  
  <!-- Preload recursos críticos con cache-busting -->
  <link rel="preload" href="/css/login.css?v=<%= Date.now() %>" as="style">
  <link rel="preload" href="/fontawesome/css/all.min.css?v=<%= Date.now() %>" as="style">
  <link rel="preload" href="/js/login.js?v=<%= Date.now() %>" as="script">
  
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  
  <!-- SOLUCIÓN: Cargar CSS de forma SINCRÓNICA para evitar FOUC -->
  <link rel="stylesheet" href="/css/login.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="/fontawesome/css/all.min.css?v=<%= Date.now() %>">
  
  <!-- Utility classes para animaciones CSP-compliant -->
  <style nonce="<%= cspNonce %>">
    .d-none{display:none!important}
    .d-block{display:block!important}
    .fade-in{animation:fadeIn .3s ease-in}
    .fade-out{animation:fadeOut .3s ease-out}
    @keyframes fadeIn{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
    @keyframes fadeOut{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-10px)}}
  </style>
</head>
<body>
<main class="wrapper" role="main" aria-label="Formulario de inicio de sesión">
  <div class="login-box">
    <form method="POST" action="/login" id="loginForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <% if (typeof redirect !== 'undefined' && redirect) { %>
        <input type="hidden" name="redirect" value="<%= redirect %>">
      <% } %>
      
      <h2><%= t('login.title') %></h2>

      <% if (error_msg && error_msg.length) { %>
        <div class="messages-container" role="alert" aria-live="assertive">
          <% error_msg.forEach(msg => { %>
            <div class="alert alert-error fade-in">
              <i class="fa-solid fa-exclamation-circle" aria-hidden="true"></i>
              <span><%= msg %></span>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (success_msg && success_msg.length) { %>
        <div class="messages-container" role="status" aria-live="polite">
          <% success_msg.forEach(msg => { %>
            <div class="alert alert-success fade-in">
              <i class="fa-solid fa-check-circle" aria-hidden="true"></i>
              <span><%= msg %></span>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- Modal de verificación de email AWS SES -->
      <% if (typeof verification_email_sent !== 'undefined' && verification_email_sent && verification_email_sent.length) { %>
        <div class="verification-notice" role="status" aria-live="polite">
          <i class="fa-solid fa-envelope-circle-check" aria-hidden="true"></i>
          <p><strong>Verifica tu correo electrónico</strong></p>
          <p>Te enviamos un correo a <strong><%= verification_email_sent[0] %></strong> de AWS SES.</p>
          <p>Debes aceptar la verificación si quieres usar los servicios de:</p>
          <ul>
            <li>Recuperación de contraseña</li>
            <li>Recibir invitaciones de grupos</li>
          </ul>
        </div>
      <% } %>
      
      <div id="logoutMessage" class="messages-container d-none" role="status" aria-live="polite">
        <div class="alert alert-success fade-in">
          <i class="fa-solid fa-check-circle" aria-hidden="true"></i>
          <span>Has cerrado sesión correctamente</span>
        </div>
      </div>

      <div class="input-box">
        <input type="email" 
               name="correo" 
               id="email" 
               required
               autocomplete="email"
               aria-required="true"
               aria-invalid="<%= form_errors && form_errors.email ? 'true' : 'false' %>"
               aria-describedby="<%= form_errors && form_errors.email ? 'email-error' : '' %>"
               placeholder="<%= t('login.email') %>"
               value="<%= form_data ? form_data.correo : '' %>"
               class="<%= form_errors && form_errors.email ? 'error' : '' %>">
        <span class="icon" aria-hidden="true"><i class="fa-solid fa-user"></i></span>
        <div class="error-message" id="email-error" role="alert" aria-live="polite"></div>
      </div>

      <div class="input-box">
        <input type="password" 
               name="password" 
               id="password" 
               required
               placeholder="<%= t('login.password') %>"
               class="<%= form_errors && form_errors.password ? 'error' : '' %>">
        <span class="icon">
          <i class="fa-solid fa-eye" id="togglePassword" title="<%= t('login.show_password') %>"></i>
        </span>
        <div class="error-message" id="password-error"></div>
      </div>

      <div class="remember-forgot">
        <a href="#" data-action="show-forgot-password"><%= t('login.forgot_password') %></a>
      </div>

      <button type="submit" id="loginButton">
        <span class="button-text"><%= t('login.login_button') %></span>
        <div class="spinner d-none" id="spinner">
          <i class="fa-solid fa-spinner fa-spin"></i>
        </div>
      </button>

      <div class="register-link">
        ¿No tienes cuenta? <a href="/auth/signup">Créala aquí</a>
      </div>
    </form>
  </div>
</main>

<script src="/js/csrf-helper.js?v=<%= Date.now() %>"></script>

<script nonce="<%= cspNonce %>">
  // Limpiar localStorage y sessionStorage al cargar la página de login
  localStorage.clear();
  sessionStorage.clear();

  // Mostrar mensaje de logout si viene de cerrar sesión
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('logout') === 'true') {
    const logoutMsg = document.getElementById('logoutMessage');
    if (logoutMsg) {
      logoutMsg.classList.remove('d-none');
      
      // Limpiar el parámetro logout de la URL sin recargar la página
      const newUrl = window.location.pathname + (urlParams.get('redirect') ? '?redirect=' + urlParams.get('redirect') : '');
      window.history.replaceState({}, '', newUrl);
      
      // Ocultar mensaje después de 5 segundos
      setTimeout(() => {
        logoutMsg.classList.add('d-none');
      }, 5000);
    }
  }
</script>

<!-- Login script con defer para no bloquear el renderizado inicial con cache-busting -->
<script src="/js/login.js?v=<%= Date.now() %>" defer></script>
</body>
</html>