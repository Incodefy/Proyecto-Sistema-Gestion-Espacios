<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Gestión de espacios y boxes - Visualización de estados y ocupación">
  <title><%= t('box.title') %></title>
  
  <!-- Token CSRF para peticiones AJAX -->
  <meta name="csrf-token" content="<%= csrfToken %>">
  
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/box.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/notifications.css">
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" as="style" id="bootstrap-preload">
  <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"></noscript>
  <link rel="preload" href="/fontawesome/css/all.min.css" as="style" id="fontawesome-preload">
  <noscript><link rel="stylesheet" href="/fontawesome/css/all.min.css"></noscript>
  
  <script nonce="<%= cspNonce %>">
    (function() {
      const bootstrap = document.getElementById('bootstrap-preload');
      const fontawesome = document.getElementById('fontawesome-preload');
      if (bootstrap) { bootstrap.onload = null; bootstrap.rel = 'stylesheet'; }
      if (fontawesome) { fontawesome.onload = null; fontawesome.rel = 'stylesheet'; }
    })();
  </script>

  <!-- El bloque <style> se ha eliminado y se reemplaza por esta línea -->
  <%- include('partials/personalization-styles') %>

</head>
<!-- Se añade el atributo data-theme al body -->
<body data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>" data-ws-endpoint="<%= wsEndpoint %>">
    <div class="container-fluid">
        <div class="row">
            <%- include('navbar') %>

            <main class="main" role="main" aria-label="Contenido principal">
                <!-- Botón flotante: Volver arriba -->
                <button id="backToTop"
                        class="back-to-top"
                        type="button"
                        aria-label="<%= t('box.back_to_top_aria') %>"
                        title="<%= t('box.back_to_top_title') %>">
                    <i class="fas fa-arrow-up" aria-hidden="true"></i>
                </button>

                <!-- Header mejorado con gradiente sutil -->
                <header class="top-header">
                    <div class="header-content">
                        <h1><%= t('box.header') %></h1>
                        <p class="header-subtitle">Gestión y visualización en tiempo real</p>
                    </div>
                </header>

                <!-- Resumen de estados - Rediseñado -->
                <section class="stats-overview" 
                         id="resumenEstados" 
                         aria-label="Resumen de estados de espacios"
                         role="region">
                    <div class="stats-grid">
                        <article class="stat-card stat-libre">
                            <div class="stat-icon">
                                <i class="fas fa-door-open"></i>
                            </div>
                            <div class="stat-content">
                                <h2 class="stat-label"><%= nomenclatura.especifico %>s <%= t('common.state_free_plural') %></h2>
                                <p class="stat-value" id="count-libre" aria-label="Cantidad de espacios libres"><%= contadoresEstados.libre %></p>
                            </div>
                        </article>
                        
                        <article class="stat-card stat-espera">
                            <div class="stat-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="stat-content">
                                <h2 class="stat-label"><%= nomenclatura.especifico %>s <%= t('common.state_waiting_plural') %></h2>
                                <p class="stat-value" id="count-en-espera" aria-label="Cantidad de espacios en espera"><%= contadoresEstados['en-espera'] %></p>
                            </div>
                        </article>
                        
                        <article class="stat-card stat-uso">
                            <div class="stat-icon">
                                <i class="fas fa-user-check"></i>
                            </div>
                            <div class="stat-content">
                                <h2 class="stat-label"><%= nomenclatura.especifico %>s <%= t('common.state_in_use_plural') %></h2>
                                <p class="stat-value" id="count-en-uso" aria-label="Cantidad de espacios en uso"><%= contadoresEstados['en-uso'] %></p>
                            </div>
                        </article>
                        
                        <article class="stat-card stat-inhabilitado">
                            <div class="stat-icon">
                                <i class="fas fa-ban"></i>
                            </div>
                            <div class="stat-content">
                                <h2 class="stat-label"><%= nomenclatura.especifico %>s <%= t('common.state_disabled_plural') %></h2>
                                <p class="stat-value" id="count-inhabilitado" aria-label="Cantidad de espacios inhabilitados"><%= contadoresEstados.inhabilitado %></p>
                            </div>
                        </article>
                    </div>
                </section>

                <!-- Filtros rediseñados -->
                <section class="filters-section" aria-label="Filtros de búsqueda">
                    <div class="filters-container">
                        <div class="filters-grid">
                            <div class="filter-group">
                                <label for="filtroPasillo" class="filter-label">
                                    <i class="fas fa-building"></i>
                                    <%= nomenclatura.general %>
                                </label>
                                <input type="text" 
                                       id="filtroPasillo" 
                                       name="filtroPasillo"
                                       class="filter-input"
                                       placeholder="<%= t('box.filters.filter_by', { tipo: nomenclatura.general }) %>" 
                                       aria-label="<%= t('box.filters.filter_by', { tipo: nomenclatura.general }) %>">
                            </div>
                            
                            <div class="filter-group">
                                <label for="filtroBox" class="filter-label">
                                    <i class="fas fa-door-closed"></i>
                                    <%= nomenclatura.especifico %>
                                </label>
                                <input type="text" 
                                       id="filtroBox" 
                                       name="filtroBox"
                                       class="filter-input"
                                       placeholder="<%= t('box.filters.filter_by', { tipo: nomenclatura.especifico }) %>" 
                                       aria-label="<%= t('box.filters.filter_by', { tipo: nomenclatura.especifico }) %>">
                            </div>
                            
                            <div class="filter-group">
                                <label for="filtroEstado" class="filter-label">
                                    <i class="fas fa-filter"></i>
                                    Estado
                                </label>
                                <select id="filtroEstado" 
                                        name="filtroEstado"
                                        class="filter-select"
                                        aria-label="<%= t('box.filters.filter_state') %>">
                                    <option value=""><%= t('box.filters.show_all') %></option>
                                    <option value="en-uso"><%= t('common.state_in_use') %></option>
                                    <option value="en-espera"><%= t('common.state_waiting') %></option>
                                    <option value="libre"><%= t('common.state_free') %></option>
                                    <option value="inhabilitado"><%= t('common.state_disabled') %></option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="filters-actions">
                            <button type="button" class="btn-action btn-secondary" data-action="reset-filters">
                                <i class="fas fa-redo"></i>
                                <%= t('common.reset_filters') %>
                            </button>
                            <button type="button" id="toggle-detalles" class="btn-action btn-primary">
                                <i class="fas fa-eye"></i>
                                <span class="btn-text"><%= t('common.show_details') %></span>
                            </button>
                        </div>
                    </div>
                </section>

                <!-- Mensaje sin resultados -->
                <div id="mensaje-no-resultados" class="no-results hidden">
                    <div class="no-results-icon">
                        <i class="fas fa-search"></i>
                    </div>
                    <h3><%= t('common.no_results') %></h3>
                    <p><%= t('common.no_results_desc') %></p>
                </div>

                <!-- Render dinámico de generales y específicos -->
                <% Object.keys(generales_especificos_map).forEach(generalNombre => { 
                    const match = generalNombre.match(/\d+/);
                    const count = match ? parseInt(match[0], 10) : 0;
                %>
                    <div class="space-section" data-general-nombre="<%= generalNombre %>">
                        <div class="section-header">
                            <div class="section-title">
                                <div class="section-icon">
                                    <i class="fas fa-layer-group"></i>
                                </div>
                                <h2><%= generalNombre %></h2>
                            </div>
                            <div class="section-badge">
                                <%= generales_especificos_map[generalNombre].length %> espacios
                            </div>
                        </div>
                        
                        <div class="spaces-grid">
                            <% generales_especificos_map[generalNombre].forEach(especifico => { %>
                                <div class="space-card-wrapper">
                                    <% if (hasAnyPermission('box.detalle.read', 'admin.users')) { %>
                                        <a href="/especifico/<%= encodeURIComponent(especifico.id) %>" 
                                           class="space-card" 
                                           data-especifico-nombre="<%= especifico.nombre %>" 
                                           data-general="<%= generalNombre %>">
                                    <% } else { %>
                                        <div class="space-card space-card-disabled" 
                                             data-especifico-nombre="<%= especifico.nombre %>" 
                                             data-general="<%= generalNombre %>"
                                             title="<%= t('box.no_permission_title') %>">
                                    <% } %>
                                        <div class="space-card-header">
                                            <h3 class="space-name"><%= especifico.nombre %></h3>
                                            <div class="space-status-indicator <%= especifico.estado.replace(/\s+/g, '-').toLowerCase() %>">
                                                <span class="status-dot"></span>
                                            </div>
                                        </div>
                                        
                                        <div id="info-especifico-<%= especifico.id %>" class="space-info">
                                            <div class="space-details <%= detallesVisibles ? '' : 'oculto' %>">
                                                <% if (especifico.estado === "Libre" && (!especifico.proxima_consulta || especifico.proxima_consulta.trim() === '')) { %>
                                                    <div class="info-item info-empty">
                                                        <i class="fas fa-calendar-check"></i>
                                                        <span><%= t('box.no_next_consultations') %></span>
                                                    </div>
                                                <% } else if (especifico.proxima_consulta) { %>
                                                    <div class="info-item">
                                                        <i class="fas fa-calendar-alt"></i>
                                                        <div class="info-content">
                                                            <span class="info-label"><%= t('box.next_appointment') %></span>
                                                            <span class="info-value"><%= especifico.proxima_consulta %></span>
                                                        </div>
                                                    </div>
                                                <% } %>
                                                
                                                <% if (especifico.medico) { %>
                                                    <div class="info-item">
                                                        <i class="fas fa-user-md"></i>
                                                        <div class="info-content">
                                                            <span class="info-label"><%= nomenclatura.ocupante %></span>
                                                            <span class="info-value"><%= especifico.medico %></span>
                                                        </div>
                                                    </div>
                                                <% } %>
                                                
                                                <% if (especifico.especialidad) { %>
                                                    <div class="info-item">
                                                        <i class="fas fa-stethoscope"></i>
                                                        <div class="info-content">
                                                            <span class="info-label"><%= nomenclatura.especialidad %></span>
                                                            <span class="info-value"><%= especifico.especialidad %></span>
                                                        </div>
                                                    </div>
                                                <% } %>
                                                
                                                <% if (especifico.consulta_actual) { %>
                                                    <div class="info-item">
                                                        <i class="fas fa-clock"></i>
                                                        <div class="info-content">
                                                            <span class="info-label"><%= t('common.hour') || t('common.start_time') %></span>
                                                            <span class="info-value"><%= especifico.consulta_actual %></span>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </div>
                                            
                                            <div class="space-status-bar <%= especifico.estado.replace(/\s+/g, '-').toLowerCase() %>">
                                                <span class="status-text"><%= especifico.estado %></span>
                                            </div>
                                        </div>
                                    <% if (hasAnyPermission('box.detalle.read', 'admin.users')) { %>
                                        </a>
                                    <% } else { %>
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            </main>

            <%- include('footer') %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/notifications.js?v=<%= Date.now() %>"></script>
    
    <!-- Protección CSRF automática -->
    <script src="/js/csrf-helper.js?v=<%= Date.now() %>"></script>
    
    <!-- Protección de sesión: Previene acceso después de logout -->
    <script src="/js/session-guard.js?v=<%= Date.now() %>"></script>
    
    <!-- Autenticación: Interceptor y renovación automática de tokens -->
    <script src="/js/auth-interceptor.js?v=<%= Date.now() %>"></script>
    <script src="/js/token-manager.js?v=<%= Date.now() %>"></script>
    
    <script nonce="<%= cspNonce %>">
        window.translations = {
            nextAppointment: "<%= t('box.next_appointment') %>",
            notNextAppointment: "<%= t('box.no_next_consultations') %>",
            doctor: "<%= t('common.doctor') %>",
            specialty: "<%= t('common.specialty') %>",
            time: "<%= t('common.hour') || t('common.start_time') %>",
            hideDetails: "<%= t('box.hide_details') %>",
            showDetails: "<%= t('common.show_details') %>"
        };
        window.nomenclatura = {
            ocupante: "<%= nomenclatura.ocupante %>",
            especialidad: "<%= nomenclatura.especialidad %>"
        };
        window.detallesVisiblesInicial = <%= detallesVisibles %>;
        window.grupoId = "<%= typeof grupoActivo === 'string' ? grupoActivo : grupoActivo.grupo_id %>";
        
        // Inicializar NotificationManager
        window.notificationManager = new NotificationManager();
    </script>
    <script src="/js/box.js?v=<%= Date.now() %>"></script>
</body>
</html>