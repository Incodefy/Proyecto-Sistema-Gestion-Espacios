<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('box.title') %></title>
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/box.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <!-- El bloque <style> se ha eliminado y se reemplaza por esta línea -->
  <%- include('partials/personalization-styles') %>

</head>
<!-- Se añade el atributo data-theme al body -->
<body data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>">
    <div class="container-fluid">
        <div class="row">
            <%- include('navbar') %>

            <div class="main">
                <!--  
                <% if (hasAnyPermission('box.write', 'admin.users')) { %>
                    <a href="/en-curso"
                        class="fab-consultas"
                        aria-label="<%= t('box.in_progress_aria') %>"
                        data-bs-toggle="tooltip"
                        data-bs-placement="left"
                        title="<%= t('box.in_progress_title') %>">
                        <i class="fas fa-stethoscope" aria-hidden="true"></i>
                    </a>
                <% } %>
                -->

                <!-- Botón flotante: Volver arriba -->
                <button id="backToTop"
                        class="back-to-top"
                        type="button"
                        aria-label="<%= t('box.back_to_top_aria') %>"
                        title="<%= t('box.back_to_top_title') %>">
                    <i class="fas fa-arrow-up" aria-hidden="true"></i>
                </button>

                <div class="top-header">
                    <div class="header-row">
                    <h1><%= t('box.header') %></h1>
                    </div>
                </div>

                <!-- Filtros -->
                <div class="filtros">
                    <div class="filtros-inputs">
                    <input type="text" id="filtroPasillo" placeholder="<%= t('box.filters.filter_by', { tipo: nomenclatura.general }) %>" aria-label="<%= t('box.filters.filter_by', { tipo: nomenclatura.general }) %>">
                    <input type="text" id="filtroBox" placeholder="<%= t('box.filters.filter_by', { tipo: nomenclatura.especifico }) %>" aria-label="<%= t('box.filters.filter_by', { tipo: nomenclatura.especifico }) %>">
                    <select id="filtroEstado" aria-label="<%= t('box.filters.filter_state') %>">
                        <option value=""><%= t('box.filters.show_all') %></option>
                        <option value="en-uso"><%= t('common.state_in_use') %></option>
                        <option value="en-espera"><%= t('common.state_waiting') %></option>
                        <option value="libre"><%= t('common.state_free') %></option>
                        <option value="inhabilitado"><%= t('common.state_disabled') %></option>
                    </select>
                    </div>
                    <div class="filtros-botones">
                    <button onclick="reiniciarFiltros()"><%= t('common.reset_filters') %></button>
                    <button id="toggle-detalles" class="btn-toggle-detalles"><%= t('common.show_details') %></button>
                    </div>
                </div>

                <!-- Resumen de estados -->
                <div class="resumen-estados row align-items-stretch" id="resumenEstados">
                    <div class="col-5 col-sm-5 col-md-3 col-lg-2 mb-4">
                    <div class="estado-card libre">
                        <h4><%= nomenclatura.especifico %>s <%= t('common.state_free_plural') %></h4>
                        <p id="count-libre"><%= contadoresEstados.libre %></p>
                    </div>
                    </div>
                    <div class="col-5 col-sm-5 col-md-3 col-lg-2 mb-4">
                    <div class="estado-card en-espera">
                        <h4><%= nomenclatura.especifico %>s <%= t('common.state_waiting_plural') %></h4>
                        <p id="count-en-espera"><%= contadoresEstados['en-espera'] %></p>
                    </div>
                    </div>
                    <div class="col-5 col-sm-5 col-md-3 col-lg-2 mb-4">
                    <div class="estado-card en-uso">
                        <h4><%= nomenclatura.especifico %>s <%= t('common.state_in_use_plural') %></h4>
                        <p id="count-en-uso"><%= contadoresEstados['en-uso'] %></p>
                    </div>
                    </div>
                    <div class="col-5 col-sm-5 col-md-3 col-lg-2 mb-4">
                    <div class="estado-card inhabilitado">
                        <h4><%= nomenclatura.especifico %>s <%= t('common.state_disabled_plural') %></h4>
                        <p id="count-inhabilitado"><%= contadoresEstados.inhabilitado %></p>
                    </div>
                    </div>
                </div>

                <!-- Mensaje sin resultados -->
                <div id="mensaje-no-resultados" class="no-resultados" style="display: none;">
                    <i class="fas fa-search"></i>
                    <h3><%= t('common.no_results') %></h3>
                    <p><%= t('common.no_results_desc') %></p>
                </div>

                <!-- Render dinámico de generales y específicos -->
                <% Object.keys(generales_especificos_map).forEach(generalNombre => { 
                    const match = generalNombre.match(/\d+/);
                    const count = match ? parseInt(match[0], 10) : 0;
                %>
                    <div class="general-bloque" data-general-nombre="<%= generalNombre %>">
                        <div class="general-nombre"><%= generalNombre %></div>
                        <div class="general-content row">
                        <% generales_especificos_map[generalNombre].forEach(especifico => { %>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-3 col-xxl-2 mb-3">
                            <% if (hasAnyPermission('box.detalle.read', 'admin.users')) { %>
                                <!-- Si tiene permiso, hacer clickeable -->
                                <a href="/especifico/<%= encodeURIComponent(especifico.id) %>" 
                                class="especifico-card" 
                                data-especifico-nombre="<%= especifico.nombre %>" 
                                data-general="<%= generalNombre %>">
                            <% } else { %>
                                <!-- Si no tiene permiso, mostrar como div sin enlace -->
                                <div class="especifico-card disabled" 
                                data-especifico-nombre="<%= especifico.nombre %>" 
                                data-general="<%= generalNombre %>"
                                title="<%= t('box.no_permission_title') %>">
                            <% } %>
                                <h3><%= especifico.nombre %></h3>
                                <div id="info-especifico-<%= especifico.id %>" class="info-especifico">
                                    <div class="contenido-especifico <%= detallesVisibles ? '' : 'oculto' %>" style="display: <%= detallesVisibles ? 'flex' : 'none' %>;">
                                        <% if (especifico.estado === "Libre" && (!especifico.proxima_consulta || especifico.proxima_consulta.trim() === '')) { %>
                                            <p><%= t('box.no_next_consultations') %></p>
                                        <% } else if (especifico.proxima_consulta) { %>
                                            <p><%= t('box.next_appointment') %>: <%= especifico.proxima_consulta %></p>
                                        <% } %>
                                        
                                        <% if (especifico.medico) { %>
                                            <p><strong><%= nomenclatura.ocupante %>:</strong> <%= especifico.medico %></p>
                                        <% } %>
                                        
                                        <% if (especifico.especialidad) { %>
                                            <p><strong><%= nomenclatura.especialidad %>:</strong> <%= especifico.especialidad %></p>
                                        <% } %>
                                        
                                        <% if (especifico.consulta_actual) { %>
                                            <p><strong><%= t('common.hour') || t('common.start_time') %>:</strong> <%= especifico.consulta_actual %></p>
                                        <% } %>
                                    </div>
                                    <div class="estado-bar <%= especifico.estado.replace(/\s+/g, '-').toLowerCase() %>">
                                        <%= especifico.estado %>
                                    </div>
                                </div>
                            <% if (hasAnyPermission('box.detalle.read', 'admin.users')) { %>
                                </a>
                            <% } else { %>
                                </div>
                            <% } %>
                            </div>
                        <% }) %>
                        </div>
                    </div>
                <% }) %>
            </div>

            <%- include('footer') %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.translations = {
            nextAppointment: "<%= t('box.next_appointment') %>",
            notNextAppointment: "<%= t('box.no_next_consultations') %>",
            doctor: "<%= t('common.doctor') %>",
            specialty: "<%= t('common.specialty') %>",
            time: "<%= t('common.hour') || t('common.start_time') %>",
            hideDetails: "<%= t('box.hide_details') %>",
            showDetails: "<%= t('common.show_details') %>"
        };
        window.nomenclatura = {
            ocupante: "<%= nomenclatura.ocupante %>",
            especialidad: "<%= nomenclatura.especialidad %>"
        };
        window.detallesVisiblesInicial = <%= detallesVisibles %>;
        window.grupoId = "<%= typeof grupoActivo === 'string' ? grupoActivo : grupoActivo.grupo_id %>";
    </script>
    <script src="/js/box.js?v=<%= Date.now() %>"></script>
</body>
</html>