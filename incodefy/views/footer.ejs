<footer class="footer" role="contentinfo">
  <div class="footer-content">
    <!-- Brand/Logo Section -->
    <div class="footer-brand">
      <div class="logo-container">
        <div class="company-logo">
          <picture>
            <source srcset="/logos/incodefy3.webp" type="image/webp">
            <img src="/logos/incodefy3.png" 
                 alt="Logo Incodefy - Sistema de Gestión Hospitalaria"
                 loading="lazy"
                 width="26"
                 height="26"
                 decoding="async" />
          </picture>
        </div>
        <h2 class="company-name">Incodefy</h2>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p class="copyright">
      <%= t('footer.copyright') %>
    </p>
  </div>
</footer>
