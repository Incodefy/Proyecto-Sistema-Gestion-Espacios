<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Detalle de espacio - Información y gestión">
  <title><%= t('detalle_box.title') %></title>
  
  <!-- Token CSRF para peticiones AJAX -->
  <meta name="csrf-token" content="<%= csrfToken %>">
  
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/detalle_box.css?v=table-calendar">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/notifications.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/fontawesome/css/all.min.css" rel="stylesheet">
  <%- include('partials/personalization-styles') %>
</head>
<body data-espacio-id="<%= espacio_id %>" data-grupo-id="<%= grupo_id %>" data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>" data-ws-endpoint="<%= wsEndpoint %>">
    <div class="container-fluid">
        <div class="row">
            <%- include("navbar") %>
            
            <main class="main-container" role="main" aria-label="Contenido principal">
                <header class="page-header fade-in">
                    <h1><i class="fas fa-cube" aria-hidden="true"></i> <%= nombre %></h1>
                </header>

                <div class="row mb-3">
                    <div class="col-12 mb-3">
                        <section class="info-card fade-in" aria-labelledby="info-heading">
                            <div class="d-flex align-items-center">
                                <div class="card-icon me-3" aria-hidden="true">
                                    <i class="fas fa-info-circle"></i>
                                </div>
                                <h2 id="info-heading" class="card-title mb-4"> <%= t('common.info') %> <%= nomenclatura.especifico %></h2>
                            </div>
                            <div class="info-grid">
                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="fas fa-tag"></i>
                                    </div>
                                    <span class="info-label"><%= t('common.name') %>:</span>
                                    <span class="info-value"> <%= nombre %></span>
                                </div>
                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </div>
                                    <span class="info-label"><%= nomenclatura.general %>:</span>
                                    <span class="info-value"><%= espacio_general_nombre %></span>
                                </div>
                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="fas fa-check-circle"></i>
                                    </div>
                                    <span class="info-label"><%= t('common.state_label') %>:</span>
                                    <span class="info-value">
                                        <span class="status-badge status-activo"> <%= estado %> </span>
                                    </span>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

                <!-- Controles de Vista con Navegación de Fechas -->
                <nav class="view-controls-bar fade-in" aria-label="Controles de visualización">
                    <div class="view-controls-container">
                        <!-- Navegación de fechas -->
                        <div class="date-navigation" role="group" aria-label="Navegación por fecha">
                            <button class="nav-btn" 
                                    type="button"
                                    data-action="navigate-date" 
                                    data-offset="-1" 
                                    aria-label="Día anterior">
                                <i class="fas fa-chevron-left" aria-hidden="true"></i>
                            </button>
                            
                            <div id="currentDateDisplay" class="current-date-display" role="status" aria-live="polite"></div>
                            
                            <button class="nav-btn" 
                                    type="button"
                                    data-action="navigate-date" 
                                    data-offset="1" 
                                    aria-label="Día siguiente">
                                <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            </button>
                            
                            <button class="today-btn" data-action="go-today">
                                <i class="fas fa-calendar-day"></i> Hoy
                            </button>
                        </div>
                        
                        <!-- Selector de vista -->
                        <div class="view-toggles">
                            <button id="dayViewBtn" class="view-btn" data-action="change-view" data-view="day">
                                <i class="fas fa-calendar-day"></i> Día
                            </button>
                            <button id="weekViewBtn" class="view-btn active" data-action="change-view" data-view="week">
                                <i class="fas fa-calendar-week"></i> Semana
                            </button>
                            <button id="monthViewBtn" class="view-btn" data-action="change-view" data-view="month">
                                <i class="fas fa-calendar"></i> Mes
                            </button>
                        </div>
                    </div>
                </nav>

                <nav class="custom-tabs fade-in" role="tablist" aria-label="Navegación de contenido">
                    <button class="tab-btn active" 
                            data-action="show-tab" 
                            data-tab="agendamientos" 
                            role="tab" 
                            aria-selected="true" 
                            aria-controls="tab-agendamientos">
                        <i class="fas fa-calendar-check" aria-hidden="true"></i> Agendamientos
                    </button>
                    <button class="tab-btn" 
                            data-action="show-tab" 
                            data-tab="estadisticas" 
                            role="tab" 
                            aria-selected="false" 
                            aria-controls="tab-estadisticas">
                        <i class="fas fa-chart-bar" aria-hidden="true"></i> <%= t('common.statistics_metrics') %>
                    </button>
                </nav>

                <!-- Contenido Agendamientos -->
                <section id="tab-agendamientos" 
                         class="tab-content active fade-in" 
                         role="tabpanel" 
                         aria-labelledby="Agendamientos">
                    <!-- Calendario Container -->
                    <div id="calendarContainer" class="calendar-container">
                        <!-- Timeline View (Día/Semana) -->
                        <div id="timelineView" class="calendar-card">
                            <div class="timeline-scroll">
                                <div id="timelineContent"></div>
                            </div>
                        </div>

                        <!-- Month View -->
                        <div id="monthView" class="calendar-card d-none">
                            <div id="monthHeader" class="month-header"></div>
                            <div id="monthGrid" class="month-grid"></div>
                        </div>
                    </div>
                </section>

                <!-- Contenido Estadísticas -->
                <section id="tab-estadisticas" 
                         class="tab-content fade-in" 
                         role="tabpanel" 
                         aria-labelledby="Estadísticas" 
                         hidden>
                    <!-- Métricas principales -->
                    <div class="metrics-grid row g-3" role="group" aria-label="Métricas principales">
                        <div class="col-6 col-lg-3">
                            <article class="metric-card">
                                <div class="metric-value" id="totalConsultas" aria-live="polite"></div>
                                <div class="metric-label">TOTAL AGENDADAS</div>
                            </article>
                        </div>
                        <div class="col-6 col-lg-3">
                            <article class="metric-card">
                                <div class="metric-value" id="usoBox" aria-live="polite"><span></span></div>
                                <div class="metric-label" id="metric-uso-label"></div>
                            </article>
                        </div>
                        <div class="col-6 col-lg-3">
                            <article class="metric-card">
                                <div class="metric-value" id="noRealizadas" aria-live="polite"></div>
                                <div class="metric-label"><%= t('common.not_done') %></div>
                            </article>
                        </div>
                        <div class="col-6 col-lg-3">
                            <article class="metric-card">
                                <div class="metric-value" id="cumplimiento" aria-live="polite"></div>
                                <div class="metric-label"><%= t('common.compliance') %></div>
                            </article>
                        </div>
                    </div>

                    <!-- Gráficos -->
                    <div class="row">
                        <div class="col-md-6">
                            <figure class="chart-card">
                                <figcaption>
                                    <h3 class="chart-title" id="chart-uso-title"></h3>
                                </figcaption>
                                <canvas id="graficoUso" 
                                        class="canvas-chart" 
                                        role="img" 
                                        aria-label="Gráfico de uso del espacio"></canvas>
                            </figure>
                        </div>
                        <div class="col-md-6">
                            <figure class="chart-card">
                                <figcaption>
                                    <h3 class="chart-title">Cumplimiento de Agendamientos</h3>
                                </figcaption>
                                <canvas id="graficoCumplimiento" 
                                        class="canvas-chart" 
                                        role="img" 
                                        aria-label="Gráfico de cumplimiento de agendamientos"></canvas>
                            </figure>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Modal Instrumentos -->
            <div id="modalInstrumentos" 
                 class="enhanced-modal" 
                 role="dialog" 
                 aria-modal="true" 
                 aria-labelledby="modal-instrumentos-title" 
                 aria-hidden="true">
                <div class="modal-content-enhanced">
                    <header class="modal-header-enhanced">
                        <h2 class="modal-title-enhanced">
                            <i class="fas fa-stethoscope" aria-hidden="true"></i>
                            <span id="modal-instrumentos-title"></span>
                        </h2>
                        <button class="close-btn" 
                                data-action="close-modal-instrumentos" 
                                aria-label="<%= t('common.close') %>">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </header>

                    <!-- Tabs de categoría (se cargarán dinámicamente) -->
                    <nav class="instrument-tabs" 
                         role="tablist" 
                         aria-label="Categorías de instrumentos" 
                         id="tabs-tipos-instrumentos">
                        <!-- Se llenarán dinámicamente con JavaScript -->
                    </nav>

                    <div class="modal-body" id="modal-instrumentos-body">
                        <!-- Se llenará dinámicamente con JavaScript -->
                    </div>
                </div>
            </div>

            <!-- Modal de Agendamiento -->
            <div id="modalAgendamiento" 
                 class="modal-overlay d-none" 
                 role="dialog" 
                 aria-modal="true" 
                 aria-labelledby="modalAgendamientoTitle">
                <div class="modal-content-modern">
                    <header class="modal-header-modern">
                        <h2 id="modalAgendamientoTitle" class="modal-title-modern">Nueva Agendación</h2>
                        <button class="close-btn-modern" 
                                data-action="close-modal-agendamiento" 
                                aria-label="Cerrar">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </header>

                    <div class="modal-body-modern">
                        <form id="formAgendamiento">
                            <input type="hidden" id="agendamientoId" value="">
                            <input type="hidden" id="agendamientoEspacioId" value="<%= espacio_id %>">
                            
                            <div class="form-group-modern">
                                <label class="form-label-modern">
                                    <i class="fas fa-user"></i> <%= nomenclatura.ocupante || 'Ocupante' %>
                                </label>
                                <select id="agendamientoOcupante" class="form-input-modern" required>
                                    <option value="">Selecciona un <%= nomenclatura.ocupante || 'ocupante' %></option>
                                </select>
                            </div>

                            <div class="form-group-modern">
                                <label class="form-label-modern">
                                    <i class="fas fa-calendar"></i> Fecha
                                </label>
                                <input type="date" id="agendamientoFecha" class="form-input-modern" required>
                            </div>

                            <div class="form-row-modern">
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-clock"></i> Hora Inicio
                                    </label>
                                    <input type="time" id="agendamientoHoraInicio" class="form-input-modern" required>
                                </div>

                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-clock"></i> Hora Fin
                                    </label>
                                    <input type="time" id="agendamientoHoraFin" class="form-input-modern" required>
                                </div>
                            </div>

                            <div class="form-group-modern">
                                <label class="form-label-modern">
                                    <i class="fas fa-sticky-note"></i> Observaciones (Opcional)
                                </label>
                                <textarea id="agendamientoObservaciones" class="form-input-modern" rows="3" placeholder="Notas adicionales..."></textarea>
                            </div>

                            <div class="form-actions-modern">
                                <button type="button" class="btn-secondary-modern" data-action="close-modal-agendamiento">
                                    <i class="fas fa-times"></i> Cancelar
                                </button>
                                <button type="submit" class="btn-primary-modern" id="btnGuardarAgendamiento">
                                    <i class="fas fa-save"></i> Guardar
                                </button>
                                <button type="button" class="btn-danger-modern d-none" id="btnEliminarAgendamiento" data-action="delete-agendamiento">
                                    <i class="fas fa-trash"></i> Eliminar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal de confirmación de eliminación -->
            <div id="confirmModal" class="confirm-modal">
                <div class="confirm-content">
                    <div class="confirm-header">
                        <div class="confirm-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                <line x1="12" y1="9" x2="12" y2="13"></line>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                        </div>
                        <div class="confirm-text">
                            <h3 id="confirmTitle">¿Eliminar agendación?</h3>
                            <p id="confirmMessage">Esta acción no se puede deshacer</p>
                        </div>
                    </div>
                    <div class="confirm-body">
                        <div id="confirmDetails" class="confirm-details"></div>
                    </div>
                    <div class="confirm-actions">
                        <button id="confirmCancelBtn" class="confirm-btn confirm-btn-cancel">Cancelar</button>
                        <button id="confirmDeleteBtn" class="confirm-btn confirm-btn-delete">Eliminar</button>
                    </div>
                </div>
            </div>
            </main>
        </div>
    </div>
    <%- include("footer") %>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Notification Manager para toasts -->
    <script src="/js/notifications.js?v=<%= Date.now() %>"></script>
    
    <!-- Protección CSRF automática -->
    <script src="/js/csrf-helper.js?v=<%= Date.now() %>"></script>
    
    <!-- Protección de sesión: Previene acceso después de logout -->
    <script src="/js/session-guard.js?v=<%= Date.now() %>"></script>
    
    <!-- Autenticación: Interceptor y renovación automática de tokens -->
    <script src="/js/auth-interceptor.js?v=<%= Date.now() %>"></script>
    <script src="/js/token-manager.js?v=<%= Date.now() %>"></script>
    
    <script src="/js/detalle_box_calendario.js?v=table-calendar"></script>
    <script src="/js/detalle_box.js?v=<%= Date.now() %>"></script>
    <script nonce="<%= cspNonce %>">
        window.userPersonalization = <%- JSON.stringify(personalization || {}) %>;
        window.nomenclatura = <%- JSON.stringify(nomenclatura || {}) %>;
        window.instrumentosData = <%- JSON.stringify(instrumentos || []) %>;
        window.grupoId = "<%= grupo_id %>";
        window.espacioId = "<%= espacio_id %>";
        window.nombre = "<%= nombre %>";
        window.translations = {
            noData: "<%= t('common.no_data') %>",
            usage: "<%= t('common.box_usage') %>",
            notDone: "<%= t('common.not_done') %>",
            compliance: "<%= t('common.compliance') %>",
            appointments: "<%= t('common.appointments') %>",
            noInstrumentsInCategory: "<%= t('common.no_items_in_category') %>",
            noInstrumentsRegistered: "<%= t('common.no_instruments_registered') %>",
            noInstrumentTypes: "No hay tipos de instrumentos configurados",
            hideDetails: "<%= t('box.hide_details') %>",
            showDetails: "<%= t('common.show_details') %>"
        };
        
        // Inicializar NotificationManager
        window.notificationManager = new NotificationManager();
    </script>
</body>
</html>