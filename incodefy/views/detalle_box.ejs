<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('detalle_box.title') %></title>
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/detalle_box.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <%- include('partials/personalization-styles') %>

  <!-- Variables CSS personalizadas adicionales -->
    <style>
        :root {
        --personalization-loaded: true;
        
        <% if (personalization && personalization['theme.primary_color']) { %>
        --primary-color: <%= personalization['theme.primary_color'] %>!important;
        <% if (personalization['theme.primary_color_light']) { %>
        --primary-color-light: <%= personalization['theme.primary_color_light'] %>!important;
        <% } %>
        <% if (personalization['theme.primary_color_dark']) { %>
        --primary-color-dark: <%= personalization['theme.primary_color_dark'] %>!important;
        <% } %>
        <% } %>
        
        <% if (personalization && personalization['theme.mode'] === 'dark') { %>
        --background-color: #181818 !important;
        --text-color: rgba(241, 241, 241, 0.98) !important;
        --secondary-text-color: #aab1bb !important;
        --card-background: #222222 !important;
        --border-color: #2b2b2b !important;
        <% } %>
        }
        <% if (personalization && personalization['theme.mode'] === 'dark') { %>
        .menu-link img {
            filter: brightness(0) invert(1)!important;
        }
        .date-input::-webkit-calendar-picker-indicator {
            filter: invert(1)!important;
        }
        <% } %>
    </style>
</head>
<body data-espacio-id="<%= espacio_id %>" data-grupo-id="<%= grupo_id %>" data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>">
    <div class="container-fluid">
        <div class="row">
            <%- include("navbar") %>
            
            <div class="main-container">
                <div class="page-header fade-in">
                    <h1><i class="fas fa-cube"></i> <%= nombre %></h1>
                </div>

                <div class="row mb-4">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-7 col-xl-8 mb-3">
                        <div class="info-card fade-in">
                            <div class="d-flex align-items-center">
                                <div class="card-icon me-3">
                                    <i class="fas fa-info-circle"></i>
                                </div>
                                <h3 class="card-title mb-4"> <%= t('common.info') %> <%= nomenclatura.especifico %></h3>
                            </div>
                            <div class="info-grid">
                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="fas fa-tag"></i>
                                    </div>
                                    <span class="info-label"><%= t('common.name') %>:</span>
                                    <span class="info-value"> <%= nombre %></span>
                                </div>
                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </div>
                                    <span class="info-label"><%= nomenclatura.general %>:</span>
                                    <span class="info-value"><%= espacio_general_nombre %></span>
                                </div>
                                <div class="info-item">
                                    <div class="info-icon">
                                        <i class="fas fa-check-circle"></i>
                                    </div>
                                    <span class="info-label"><%= t('common.state_label') %>:</span>
                                    <span class="info-value">
                                        <span class="status-badge status-activo"> <%= estado %> </span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-6 col-lg-5 col-xl-4 mb-3">
                        <div class="date-selector-card fade-in">
                            <div class="d-flex align-items-center">
                                <div class="card-icon me-3">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                                <h3 class="card-title mb-4"><%= t('common.select_date_label') %></h3>
                            </div>
                            <div class="date-controls">
                                <button class="date-btn" onclick="cambiarFecha(-1)" aria-label="<%= t('common.previous_day') %>" title="<%= t('common.previous_day') %>">
                                    <i class="fas fa-chevron-left"></i>
                                </button>

                                <div class="current-date" id="fechaLabel"></div>

                                <button class="date-btn" onclick="cambiarFecha(1)" aria-label="<%= t('common.next_day') %>" title="<%= t('common.next_day') %>">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </div>
                            <div class="mt-3 text-center">
                                <input type="date" class="date-input" id="selectorFecha" aria-label="<%= t('common.select_date_input') %>" onchange="seleccionarFecha(this.value)">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Controles de Vista (compartidos por ambos tabs) -->
                <div class="view-controls-bar fade-in">
                    <div class="view-toggles">
                        <button id="dayViewBtn" class="view-btn active" onclick="cambiarVista('day')">
                            <i class="fas fa-calendar-day"></i> Día
                        </button>
                        <button id="weekViewBtn" class="view-btn" onclick="cambiarVista('week')">
                            <i class="fas fa-calendar-week"></i> Semana
                        </button>
                        <button id="monthViewBtn" class="view-btn" onclick="cambiarVista('month')">
                            <i class="fas fa-calendar"></i> Mes
                        </button>
                    </div>
                </div>

                <div class="custom-tabs fade-in">
                    <button class="tab-btn active" onclick="mostrarTab('agendamientos')">
                        <i class="fas fa-calendar-check"></i> Agendamientos del día
                    </button>
                    <button class="tab-btn" onclick="mostrarTab('estadisticas')">
                        <i class="fas fa-chart-bar"></i> <%= t('common.statistics_metrics') %>
                    </button>
                </div>

                <!-- Contenido Agendamientos -->
                <div id="tab-agendamientos" class="tab-content active fade-in">
                    <!-- Botón para crear nueva cita -->
                    <div class="actions-bar mb-3">
                        <button class="btn-primary-custom" onclick="abrirModalAgendamiento()">
                            <i class="fas fa-plus"></i> Nueva Agendación
                        </button>
                    </div>

                    <!-- Calendario Container -->
                    <div id="calendarContainer" class="calendar-container">
                        <!-- Timeline View (Día/Semana) -->
                        <div id="timelineView" class="calendar-card">
                            <div class="timeline-scroll">
                                <div id="timelineContent"></div>
                            </div>
                        </div>

                        <!-- Month View -->
                        <div id="monthView" class="calendar-card" style="display: none;">
                            <div id="monthHeader" class="month-header"></div>
                            <div id="monthGrid" class="month-grid"></div>
                        </div>
                    </div>
                </div>

                <!-- Contenido Estadísticas -->
                <div id="tab-estadisticas" class="tab-content fade-in">
                    <!-- Métricas principales -->
                    <div class="metrics-grid row g-3">
                        <div class="col-6 col-lg-3">
                            <div class="metric-card">
                                <div class="metric-value" id="totalConsultas"></div>
                                <div class="metric-label">TOTAL AGENDADAS</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="metric-card">
                                <div class="metric-value" id="usoBox"><span></span></div>
                                <div class="metric-label" id="metric-uso-label"></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="metric-card">
                                <div class="metric-value" id="noRealizadas"></div>
                                <div class="metric-label"><%= t('common.not_done') %></div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="metric-card">
                                <div class="metric-value" id="cumplimiento"></div>
                                <div class="metric-label"><%= t('common.compliance') %></div>
                            </div>
                        </div>
                    </div>

                    <!-- Gráficos -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="chart-card">
                                <h4 class="chart-title" id="chart-uso-title"></h4>
                                <canvas id="graficoUso" style="max-height: 350px;"></canvas>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="chart-card">
                                <h4 class="chart-title">Cumplimiento de Agendamientos</h4>
                                <canvas id="graficoCumplimiento" style="max-height: 350px;"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Instrumentos -->
            <div id="modalInstrumentos" class="enhanced-modal" aria-hidden="true">
                <div class="modal-content-enhanced">
                    <div class="modal-header-enhanced">
                        <h3 class="modal-title-enhanced">
                            <i class="fas fa-stethoscope"></i>
                            <span id="modal-instrumentos-title"></span>
                        </h3>
                        <button class="close-btn" onclick="cerrarModalInstrumentos()" aria-label="<%= t('common.close') %>">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>

                    <!-- Tabs de categoría (se cargarán dinámicamente) -->
                    <div class="instrument-tabs" role="tablist" aria-label="Categorías de instrumentos" id="tabs-tipos-instrumentos">
                        <!-- Se llenarán dinámicamente con JavaScript -->
                    </div>

                    <div class="modal-body" id="modal-instrumentos-body">
                        <!-- Se llenará dinámicamente con JavaScript -->
                    </div>
                </div>
            </div>

            <!-- Modal de Agendamiento -->
            <div id="modalAgendamiento" class="modal-overlay" style="display: none;">
                <div class="modal-content-modern">
                    <div class="modal-header-modern">
                        <h2 id="modalAgendamientoTitle" class="modal-title-modern">Nueva Agendación</h2>
                        <button class="close-btn-modern" onclick="cerrarModalAgendamiento()" aria-label="Cerrar">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <div class="modal-body-modern">
                        <form id="formAgendamiento">
                            <input type="hidden" id="agendamientoId" value="">
                            <input type="hidden" id="agendamientoEspacioId" value="<%= espacio_id %>">
                            
                            <div class="form-group-modern">
                                <label class="form-label-modern">
                                    <i class="fas fa-user"></i> <%= nomenclatura.ocupante || 'Ocupante' %>
                                </label>
                                <select id="agendamientoOcupante" class="form-input-modern" required>
                                    <option value="">Selecciona un <%= nomenclatura.ocupante || 'ocupante' %></option>
                                </select>
                            </div>

                            <div class="form-group-modern">
                                <label class="form-label-modern">
                                    <i class="fas fa-calendar"></i> Fecha
                                </label>
                                <input type="date" id="agendamientoFecha" class="form-input-modern" required>
                            </div>

                            <div class="form-row-modern">
                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-clock"></i> Hora Inicio
                                    </label>
                                    <input type="time" id="agendamientoHoraInicio" class="form-input-modern" required>
                                </div>

                                <div class="form-group-modern">
                                    <label class="form-label-modern">
                                        <i class="fas fa-clock"></i> Hora Fin
                                    </label>
                                    <input type="time" id="agendamientoHoraFin" class="form-input-modern" required>
                                </div>
                            </div>

                            <div class="form-group-modern">
                                <label class="form-label-modern">
                                    <i class="fas fa-sticky-note"></i> Observaciones (Opcional)
                                </label>
                                <textarea id="agendamientoObservaciones" class="form-input-modern" rows="3" placeholder="Notas adicionales..."></textarea>
                            </div>

                            <div class="form-actions-modern">
                                <button type="button" class="btn-secondary-modern" onclick="cerrarModalAgendamiento()">
                                    <i class="fas fa-times"></i> Cancelar
                                </button>
                                <button type="submit" class="btn-primary-modern" id="btnGuardarAgendamiento">
                                    <i class="fas fa-save"></i> Guardar
                                </button>
                                <button type="button" class="btn-danger-modern" id="btnEliminarAgendamiento" style="display: none;" onclick="eliminarAgendamiento()">
                                    <i class="fas fa-trash"></i> Eliminar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <%- include("footer") %>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/detalle_box_calendario.js?v=<%= Date.now() %>"></script>
    <script src="/js/detalle_box.js?v=<%= Date.now() %>"></script>
    <script>
        window.userPersonalization = <%- JSON.stringify(personalization || {}) %>;
        window.nomenclatura = <%- JSON.stringify(nomenclatura || {}) %>;
        window.instrumentosData = <%- JSON.stringify(instrumentos || []) %>;
        window.grupoId = "<%= grupo_id %>";
        window.espacioId = "<%= espacio_id %>";
        window.nombre = "<%= nombre %>";
        window.translations = {
            noData: "<%= t('common.no_data') %>",
            usage: "<%= t('common.box_usage') %>",
            notDone: "<%= t('common.not_done') %>",
            compliance: "<%= t('common.compliance') %>",
            appointments: "<%= t('common.appointments') %>",
            noInstrumentsInCategory: "<%= t('common.no_items_in_category') %>",
            noInstrumentsRegistered: "<%= t('common.no_instruments_registered') %>",
            noInstrumentTypes: "No hay tipos de instrumentos configurados"
        };
    </script>
</body>
</html>