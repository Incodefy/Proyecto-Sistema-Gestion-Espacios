<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Aceptar invitación al grupo - Sistema de Gestión Hospitalaria">
  <title>Aceptar Invitación - Sistema de Gestión Hospitalaria</title>
  <link rel="stylesheet" href="/css/aceptar-invitacion.css">
</head>
<body>
  <div class="invitation-container">
    <div class="header">
      <h1>Invitación a grupo</h1>
      <p>Has sido invitado a colaborar</p>
    </div>

    <div class="content">
      <% if (user) { %>
        <!-- Usuario autenticado -->
        <div class="user-session">
          <span class="user-session-icon">✓</span>
          <div class="user-session-text">
            <strong>Sesión activa:</strong> <%= user.email %>
          </div>
        </div>
      <% } %>

      <h2 class="section-title">Detalles de la invitación</h2>

      <div class="details-card">
        <div class="detail-row">
          <span class="detail-label">Grupo</span>
          <span class="detail-value"><%= invitation.group_name %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Rol asignado</span>
          <span class="role-badge"><%= invitation.role %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Correo invitado</span>
          <span class="detail-value"><%= invitation.email %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Fecha</span>
          <span class="detail-value"><%= new Date(invitation.created_at).toLocaleDateString('es-CL') %></span>
        </div>
      </div>

      <div id="messageContainer"></div>

      <% if (user) { %>
        <!-- Usuario logueado - puede aceptar directamente -->
        <% if (user.email.toLowerCase() === invitation.email.toLowerCase()) { %>
          <button id="btnAccept" class="btn btn-primary">
            <span class="icon">✓</span> Aceptar invitación
          </button>
          <p class="footer-text">
            Al aceptar, serás agregado al grupo con rol de <%= invitation.role %>
          </p>
        <% } else { %>
          <div class="alert alert-warning">
            <span class="alert-icon">⚠</span>
            <div>
              <strong>Correo no coincide</strong>
              Esta invitación fue enviada a <strong><%= invitation.email %></strong> 
              pero estás conectado como <strong><%= user.email %></strong>. 
              Por favor, cierra sesión e inicia con el correo correcto.
            </div>
          </div>
          <a href="/logout?redirect=<%= encodeURIComponent('/aceptar-invitacion?token=' + token) %>" class="btn btn-secondary">
            <span class="icon">←</span> Cerrar sesión
          </a>
        <% } %>
      <% } else { %>
        <!-- Usuario NO logueado - debe iniciar sesión o registrarse -->
        <div class="alert alert-info">
          <span class="alert-icon">ⓘ</span>
          <div>
            <strong>Debes iniciar sesión</strong>
            Para aceptar esta invitación, inicia sesión con tu cuenta o crea una nueva.
          </div>
        </div>
        <a href="/login?redirect=<%= encodeURIComponent('/aceptar-invitacion?token=' + token) %>" class="btn btn-primary">
          <span class="icon">→</span> Iniciar sesión
        </a>
        <p class="footer-text">
          ¿No tienes cuenta? 
          <a href="/register?redirect=<%= encodeURIComponent('/aceptar-invitacion?token=' + token) %>">
            Regístrate aquí
          </a>
        </p>
      <% } %>
    </div>
  </div>

  <script nonce="<%= nonce %>">
    <% if (user && user.email.toLowerCase() === invitation.email.toLowerCase()) { %>
    document.getElementById('btnAccept').addEventListener('click', async () => {
      const btn = document.getElementById('btnAccept');
      const messageContainer = document.getElementById('messageContainer');
      
      console.log('🔘 Botón aceptar clickeado');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span> Procesando...';
      
      try {
        console.log('📡 Enviando request a /aceptar-invitacion...');
        const response = await fetch('/aceptar-invitacion', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= csrfToken %>'
          },
          body: JSON.stringify({
            token: '<%= token %>'
          })
        });
        
        console.log('📥 Respuesta recibida:', response.status, response.statusText);
        const data = await response.json();
        console.log('📊 Data:', data);
        
        if (data.ok) {
          console.log('✅ Invitación aceptada');
          messageContainer.innerHTML = `
            <div class="alert alert-success">
              <span class="alert-icon">✓</span>
              <div>
                <strong>¡Invitación aceptada!</strong>
                Ya eres miembro del grupo. Redirigiendo...
              </div>
            </div>
          `;
          
          setTimeout(() => {
            console.log('🔀 Redirigiendo a:', data.redirect || '/dashboard');
            window.location.href = data.redirect || '/dashboard';
          }, 2000);
        } else {
          throw new Error(data.error || 'Error al aceptar la invitación');
        }
      } catch (error) {
        console.error('❌ Error:', error);
        messageContainer.innerHTML = `
          <div class="alert alert-danger">
            <span class="alert-icon">✕</span>
            <div>
              <strong>Error</strong>
              ${error.message}
            </div>
          </div>
        `;
        btn.disabled = false;
        btn.innerHTML = '<span class="icon">✓</span> Aceptar invitación';
      }
    });
    <% } %>
  </script>
</body>
</html>