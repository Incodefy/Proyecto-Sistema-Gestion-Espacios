<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Aceptar invitación al grupo - Sistema de Gestión Hospitalaria">
  <title>Aceptar Invitación - Sistema de Gestión Hospitalaria</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background-color: #fafafa;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      line-height: 1.6;
    }
    
    .invitation-container {
      background: #ffffff;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
      max-width: 560px;
      width: 100%;
      overflow: hidden;
    }
    
    .header {
      padding: 48px 40px 32px;
      text-align: center;
      border-bottom: 1px solid #f0f0f0;
    }
    
    .header-icon {
      font-size: 48px;
      margin-bottom: 16px;
    }
    
    .header h1 {
      font-size: 28px;
      font-weight: 600;
      color: #1a1a1a;
      letter-spacing: -0.5px;
      margin-bottom: 8px;
    }
    
    .header p {
      font-size: 15px;
      color: #737373;
    }
    
    .content {
      padding: 40px;
    }
    
    .user-session {
      background-color: #f0fdf4;
      border-radius: 8px;
      padding: 16px 20px;
      margin-bottom: 32px;
      border-left: 3px solid #22c55e;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    
    .user-session-icon {
      font-size: 18px;
      color: #15803d;
    }
    
    .user-session-text {
      font-size: 14px;
      color: #15803d;
    }
    
    .user-session-text strong {
      font-weight: 600;
    }
    
    .section-title {
      font-size: 16px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 20px;
      letter-spacing: -0.3px;
    }
    
    .details-card {
      background-color: #fafafa;
      border-radius: 8px;
      padding: 24px;
      margin-bottom: 32px;
      border: 1px solid #f0f0f0;
    }
    
    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid #f0f0f0;
    }
    
    .detail-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    
    .detail-row:first-child {
      padding-top: 0;
    }
    
    .detail-label {
      font-size: 13px;
      color: #737373;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .detail-value {
      font-size: 15px;
      color: #1a1a1a;
      font-weight: 500;
      text-align: right;
    }
    
    .role-badge {
      display: inline-block;
      padding: 6px 14px;
      background-color: #1a1a1a;
      color: #ffffff;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.3px;
    }
    
    .btn {
      display: block;
      width: 100%;
      padding: 14px 24px;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.3px;
      border-radius: 8px;
      text-align: center;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: inherit;
    }
    
    .btn-primary {
      background-color: #1a1a1a;
      color: #ffffff;
      margin-bottom: 12px;
    }
    
    .btn-primary:hover:not(:disabled) {
      background-color: #2d2d2d;
      transform: translateY(-1px);
    }
    
    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    
    .btn-secondary {
      background-color: #ffffff;
      color: #1a1a1a;
      border: 1.5px solid #e5e5e5;
    }
    
    .btn-secondary:hover {
      background-color: #fafafa;
      border-color: #d4d4d4;
    }
    
    .alert {
      border-radius: 8px;
      padding: 16px 20px;
      margin-bottom: 24px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 14px;
      line-height: 1.5;
    }
    
    .alert-icon {
      font-size: 18px;
      flex-shrink: 0;
      margin-top: 1px;
    }
    
    .alert-info {
      background-color: #eff6ff;
      color: #1e40af;
      border-left: 3px solid #3b82f6;
    }
    
    .alert-warning {
      background-color: #fffbeb;
      color: #78350f;
      border-left: 3px solid #fbbf24;
    }
    
    .alert-success {
      background-color: #f0fdf4;
      color: #15803d;
      border-left: 3px solid #22c55e;
    }
    
    .alert-danger {
      background-color: #fef2f2;
      color: #991b1b;
      border-left: 3px solid #ef4444;
    }
    
    .alert strong {
      font-weight: 600;
      display: block;
      margin-bottom: 4px;
    }
    
    .footer-text {
      text-align: center;
      font-size: 13px;
      color: #a3a3a3;
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid #f0f0f0;
    }
    
    .footer-text a {
      color: #1a1a1a;
      text-decoration: none;
      font-weight: 500;
      border-bottom: 1px solid #d4d4d4;
      transition: border-color 0.2s ease;
    }
    
    .footer-text a:hover {
      border-bottom-color: #1a1a1a;
    }
    
    .icon {
      margin-right: 8px;
    }
    
    .spinner {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-right: 8px;
    }
    
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    
    @media (max-width: 600px) {
      body {
        padding: 10px;
      }
      
      .header {
        padding: 36px 24px 24px;
      }
      
      .content {
        padding: 32px 24px;
      }
      
      .details-card {
        padding: 20px;
      }
      
      .detail-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
      }
      
      .detail-value {
        text-align: left;
      }
    }
  </style>
</head>
<body>
  <div class="invitation-container">
    <div class="header">
      <div class="header-icon">✉️</div>
      <h1>Invitación a grupo</h1>
      <p>Has sido invitado a colaborar</p>
    </div>

    <div class="content">
      <% if (user) { %>
        <!-- Usuario autenticado -->
        <div class="user-session">
          <span class="user-session-icon">✓</span>
          <div class="user-session-text">
            <strong>Sesión activa:</strong> <%= user.email %>
          </div>
        </div>
      <% } %>

      <h2 class="section-title">Detalles de la invitación</h2>

      <div class="details-card">
        <div class="detail-row">
          <span class="detail-label">Grupo</span>
          <span class="detail-value"><%= invitation.group_name %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Rol asignado</span>
          <span class="role-badge"><%= invitation.role %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Correo invitado</span>
          <span class="detail-value"><%= invitation.email %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Fecha</span>
          <span class="detail-value"><%= new Date(invitation.created_at).toLocaleDateString('es-CL') %></span>
        </div>
      </div>

      <div id="messageContainer"></div>

      <% if (user) { %>
        <!-- Usuario logueado - puede aceptar directamente -->
        <% if (user.email.toLowerCase() === invitation.email.toLowerCase()) { %>
          <button id="btnAccept" class="btn btn-primary">
            <span class="icon">✓</span> Aceptar invitación
          </button>
          <p class="footer-text">
            Al aceptar, serás agregado al grupo con rol de <%= invitation.role %>
          </p>
        <% } else { %>
          <div class="alert alert-warning">
            <span class="alert-icon">⚠</span>
            <div>
              <strong>Correo no coincide</strong>
              Esta invitación fue enviada a <strong><%= invitation.email %></strong> 
              pero estás conectado como <strong><%= user.email %></strong>. 
              Por favor, cierra sesión e inicia con el correo correcto.
            </div>
          </div>
          <a href="/logout" class="btn btn-secondary">
            <span class="icon">←</span> Cerrar sesión
          </a>
        <% } %>
      <% } else { %>
        <!-- Usuario NO logueado - debe iniciar sesión o registrarse -->
        <div class="alert alert-info">
          <span class="alert-icon">ⓘ</span>
          <div>
            <strong>Debes iniciar sesión</strong>
            Para aceptar esta invitación, inicia sesión con tu cuenta o crea una nueva.
          </div>
        </div>
        <a href="/login?redirect=<%= encodeURIComponent('/aceptar-invitacion?token=' + token) %>" class="btn btn-primary">
          <span class="icon">→</span> Iniciar sesión
        </a>
        <p class="footer-text">
          ¿No tienes cuenta? 
          <a href="/register?redirect=<%= encodeURIComponent('/aceptar-invitacion?token=' + token) %>">
            Regístrate aquí
          </a>
        </p>
      <% } %>
    </div>
  </div>

  <script>
    <% if (user && user.email.toLowerCase() === invitation.email.toLowerCase()) { %>
    document.getElementById('btnAccept').addEventListener('click', async () => {
      const btn = document.getElementById('btnAccept');
      const messageContainer = document.getElementById('messageContainer');
      
      console.log('🔘 Botón aceptar clickeado');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span> Procesando...';
      
      try {
        console.log('📡 Enviando request a /aceptar-invitacion...');
        const response = await fetch('/aceptar-invitacion', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            token: '<%= token %>'
          })
        });
        
        console.log('📥 Respuesta recibida:', response.status, response.statusText);
        const data = await response.json();
        console.log('📊 Data:', data);
        
        if (data.ok) {
          console.log('✅ Invitación aceptada');
          messageContainer.innerHTML = `
            <div class="alert alert-success">
              <span class="alert-icon">✓</span>
              <div>
                <strong>¡Invitación aceptada!</strong>
                Ya eres miembro del grupo. Redirigiendo...
              </div>
            </div>
          `;
          
          setTimeout(() => {
            console.log('🔀 Redirigiendo a:', data.redirect || '/dashboard');
            window.location.href = data.redirect || '/dashboard';
          }, 2000);
        } else {
          throw new Error(data.error || 'Error al aceptar la invitación');
        }
      } catch (error) {
        console.error('❌ Error:', error);
        messageContainer.innerHTML = `
          <div class="alert alert-danger">
            <span class="alert-icon">✕</span>
            <div>
              <strong>Error</strong>
              ${error.message}
            </div>
          </div>
        `;
        btn.disabled = false;
        btn.innerHTML = '<span class="icon">✓</span> Aceptar invitación';
      }
    });
    <% } %>
  </script>
</body>
</html>