<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Resultado de verificación de correo electrónico">
  <title><%= success ? 'Verificación Exitosa' : 'Error de Verificación' %> - Sistema de Gestión Hospitalaria</title>
  <link rel="stylesheet" href="/css/login.css">
  <link rel="stylesheet" href="/fontawesome/css/all.min.css">
  <style>
    .verification-box {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
      border: 1px solid rgba(255, 255, 255, 0.18);
      max-width: 500px;
      margin: 0 auto;
      text-align: center;
    }

    .verification-icon {
      font-size: 80px;
      margin-bottom: 20px;
    }

    .verification-icon.success {
      color: #4caf50;
      animation: scaleIn 0.5s ease-out;
    }

    .verification-icon.error {
      color: #f44336;
      animation: shake 0.5s ease-out;
    }

    @keyframes scaleIn {
      0% { transform: scale(0); opacity: 0; }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); opacity: 1; }
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      10%, 30%, 50%, 70%, 90% { transform: translateX(-10px); }
      20%, 40%, 60%, 80% { transform: translateX(10px); }
    }

    .verification-box h2 {
      color: white;
      margin-bottom: 20px;
      font-size: 28px;
    }

    .verification-box p {
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.6;
      margin-bottom: 30px;
      font-size: 16px;
    }

    .btn-login {
      display: inline-block;
      padding: 12px 30px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .btn-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
    }

    .btn-login i {
      margin-right: 8px;
    }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="verification-box">
    <div class="verification-icon <%= success ? 'success' : 'error' %>">
      <i class="fas <%= success ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
    </div>
    
    <h2><%= success ? '¡Verificación Exitosa!' : 'Error de Verificación' %></h2>
    
    <p><%= message %></p>
    
    <% if (success) { %>
      <a href="/login" class="btn-login">
        <i class="fas fa-sign-in-alt"></i>
        Iniciar Sesión
      </a>
    <% } else { %>
      <a href="/auth/signup" class="btn-login">
        <i class="fas fa-redo"></i>
        Intentar Nuevamente
      </a>
    <% } %>
  </div>
</div>
</body>
</html>
