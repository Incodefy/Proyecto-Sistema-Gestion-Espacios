<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
  <meta charset="UTF-8">
  <title><%= t('agenda.title') %></title>
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/agenda.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  
  <%- include('partials/personalization-styles') %>
</head>
<body data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>">
  
  <!-- Toast Container -->
  <div class="toast-container">
    <div id="devToast" class="toast custom-toast" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="toast-header">
        <i class="fas fa-tools me-2"></i>
        <strong class="me-auto">En Desarrollo</strong>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
      <div class="toast-body">
        <i class="fas fa-info-circle me-2"></i>
        Interfaz en desarrollo, próximamente se encontrará disponible.
      </div>
    </div>
  </div>

  <%- include('navbar') %>

  <div class="container-fluid">
    <div class="row">
      <div class="main">
        <div class="top-header">
          <h1 class="page-title"><%= t('agenda.main_title') %></h1>
          <p class="page-subtitle"><%= t('agenda.main_subtitle') %></p>
        </div>

        <div class="options-grid">
          
          <!-- Opción: Agendar - Requiere agenda.read -->
          <% if (canViewAgenda) { %>
            <div class="option-item">
              <a href="/agenda/gestion" class="option-card-new">
                <div class="option-icon calendar-icon">
                  <i class="fas fa-calendar-plus"></i>
                </div>
                <div class="option-content">
                  <h3 class="option-title"><%= t('agenda.data.agendar') %></h3>
                  <p class="option-description">Crea y gestiona citas médicas de forma rápida</p>
                </div>
                <div class="option-arrow">
                  <i class="fas fa-chevron-right"></i>
                </div>
              </a>
            </div>
          <% } %>

          <!-- Opción: Importar - Requiere data.import -->
          <% if (canImport) { %>
            <div class="option-item">
              <a href="#" class="option-card-new" onclick="showDevToast(event)">
                <div class="option-icon import-icon">
                  <i class="fas fa-file-import"></i>
                </div>
                <div class="option-content">
                  <h3 class="option-title"><%= t('agenda.data.import') %></h3>
                  <p class="option-description">Importa datos desde archivos externos</p>
                </div>
                <div class="option-arrow">
                  <i class="fas fa-chevron-right"></i>
                </div>
              </a>
            </div>
          <% } %>
          
          <!-- Opción: Exportar - Requiere data.export -->
          <% if (canExport) { %>
            <div class="option-item">
              <a href="#" class="option-card-new" onclick="showDevToast(event)">
                <div class="option-icon export-icon">
                  <i class="fas fa-file-export"></i>
                </div>
                <div class="option-content">
                  <h3 class="option-title"><%= t('agenda.data.export') %></h3>
                  <p class="option-description">Exporta información de consultas y citas</p>
                </div>
                <div class="option-arrow">
                  <i class="fas fa-chevron-right"></i>
                </div>
              </a>
            </div>
          <% } %>

          <!-- Mensaje si no tiene permisos para ninguna opción -->
          <% if (!canViewAgenda && !canImport && !canExport) { %>
            <div class="col-12 text-center no-permissions-container">
              <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle mb-3"></i>
                <h4><%= t('agenda.no_permissions.title') %></h4>
                <p><%= t('agenda.no_permissions.description') %></p>
              </div>
            </div>
          <% } %>

        </div>
      </div>

      <%- include('footer') %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    window.userPersonalization = <%- JSON.stringify(personalization || {}) %>;
    
    function showDevToast(event) {
      event.preventDefault();
      
      const toastElement = document.getElementById('devToast');
      const toast = new bootstrap.Toast(toastElement, {
        autohide: true,
        delay: 4000
      });
      
      toast.show();
    }
  </script>
</body>
</html>