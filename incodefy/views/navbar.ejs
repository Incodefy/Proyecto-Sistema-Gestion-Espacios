<nav class="custom-navbar" role="navigation" aria-label="Menú principal">
  <button class="navbar-toggle" 
          data-action="toggle-navbar" 
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="navbar-menu">
    <i class="fas fa-bars" aria-hidden="true"></i>
  </button>

  <!-- Overlay para cerrar el menú -->
  <div class="navbar-overlay" data-action="close-navbar" aria-hidden="true"></div>

  <ul class="navbar-menu" id="navbar-menu" role="menubar">
    <% if (user) { %>
      <!-- Dashboard -->
      <li role="none">
        <a href="/dashboard" 
           class="menu-link <%= currentPath === '/dashboard' ? 'active' : '' %>" 
           role="menuitem"
           aria-current="<%= currentPath === '/dashboard' ? 'page' : 'false' %>"
           aria-label="<%= t('navbar.dashboard') %>"
           data-tooltip="<%= t('navbar.dashboard') %>">
          <img src="/icons/dashboard.webp" alt="" aria-hidden="true" width="25" height="25" loading="lazy">
          <span><%= t('navbar.dashboard') %></span>
        </a>
      </li>
      
      <!-- Agenda -->
      <li role="none">
        <a href="/agenda" 
           class="menu-link <%= currentPath.startsWith('/agenda') ? 'active' : '' %>" 
           role="menuitem"
           aria-current="<%= currentPath.startsWith('/agenda') ? 'page' : 'false' %>"
           aria-label="<%= t('navbar.agenda') %>"
           data-tooltip="<%= t('navbar.agenda') %>">
          <img src="/icons/calendario.webp" alt="" aria-hidden="true" width="25" height="25" loading="lazy">
          <span><%= t('navbar.agenda') %></span>
        </a>
      </li>
      
      <!-- Espacio Específico -->
      <li role="none">
        <a href="/especifico" 
           class="menu-link <%= (currentPath.startsWith('/especifico') || currentPath === '/en-curso') ? 'active' : '' %>" 
           role="menuitem"
           aria-current="<%= (currentPath.startsWith('/especifico') || currentPath === '/en-curso') ? 'page' : 'false' %>"
           aria-label="<%= nomenclatura ? nomenclatura.especifico : 'Especifico' %>"
           data-tooltip="<%= nomenclatura ? nomenclatura.especifico : 'Especifico' %>">
          <img src="/icons/espacio.webp" alt="" aria-hidden="true" width="25" height="25" loading="lazy">
          <span><%= nomenclatura ? nomenclatura.especifico : 'Especifico' %></span>
        </a>
      </li>
      
      <!-- Notificaciones -->
      <li role="none">
        <a href="/historial-notificaciones" 
           class="menu-link <%= currentPath.startsWith('/historial-notificaciones') ? 'active' : '' %>" 
           role="menuitem"
           aria-current="<%= currentPath.startsWith('/historial-notificaciones') ? 'page' : 'false' %>"
           aria-label="<%= t('navbar.notifications') %>"
           data-tooltip="<%= t('navbar.notifications') %>">
          <img src="/icons/notificaciones.webp" 
               alt="" 
               aria-hidden="true" 
               class="noti" 
               width="24" 
               height="24"
               loading="lazy">
          <span><%= t('navbar.notifications') %></span>
        </a>
      </li>
      
      <!-- Gestión de Grupo (solo owner y admin) -->
      <% if (locals.userRole === 'owner' || locals.userRole === 'admin') { %>
      <li role="none">
        <a href="/gestion-grupo" 
           class="menu-link <%= currentPath.startsWith('/gestion-grupo') ? 'active' : '' %>" 
           role="menuitem"
           aria-current="<%= currentPath.startsWith('/gestion-grupo') ? 'page' : 'false' %>"
           aria-label="<%= t('navbar.manageGroup') %>"
           data-tooltip="<%= t('navbar.manageGroup') %>">
          <img src="/icons/grupo.webp" alt="" aria-hidden="true" class="gestion" width="25" height="25" loading="lazy">
          <span><%= t('navbar.manageGroup') %></span>
        </a>
      </li>
      <% } %>
    <% } %>

    <li role="none">
      <a href="/perfil" 
         class="menu-link <%= currentPath.startsWith('/perfil') ? 'active' : '' %>" 
         role="menuitem"
         aria-current="<%= currentPath.startsWith('/perfil') ? 'page' : 'false' %>"
         aria-label="<%= t('navbar.profile') %>"
         data-tooltip="<%= t('navbar.profile') %>">
        <img src="/icons/perfil.webp" alt="" aria-hidden="true" class="perfil" width="24" height="25" loading="lazy">
        <span><%= t('navbar.profile') %></span>
      </a>
    </li>
    
    <!-- Logout siempre visible -->
    <li role="none">
      <a href="/logout" class="logout-button" role="menuitem">
        <span><%= t('navbar.logout') %></span>
      </a>
    </li>
  </ul>
  <div class="reloj-wrapper" id="reloj"></div>
</nav>

<script src="/js/navbar.js"></script>
