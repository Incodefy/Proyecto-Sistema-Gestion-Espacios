<nav class="custom-navbar" role="navigation" aria-label="Menú principal">
  <button class="navbar-toggle" 
          data-action="toggle-navbar" 
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="navbar-menu">
    <i class="fas fa-bars" aria-hidden="true"></i>
  </button>

  <!-- Overlay para cerrar el menú -->
  <div class="navbar-overlay" data-action="close-navbar" aria-hidden="true"></div>

  <ul class="navbar-menu" id="navbar-menu" role="menubar">
    <% if (user) { %>
      <!-- Dashboard -->
      <li role="none">
        <a href="/dashboard" 
           class="menu-link <%= currentPath === '/dashboard' ? 'active' : '' %>" 
           role="menuitem"
           aria-current="<%= currentPath === '/dashboard' ? 'page' : 'false' %>">
          <img src="/icons/dashboard.webp" alt="" aria-hidden="true">
          <span><%= t('navbar.dashboard') %></span>
        </a>
      </li>
      
      <!-- Agenda -->
      <li role="none">
        <a href="/agenda" 
           class="menu-link <%= currentPath.startsWith('/agenda') ? 'active' : '' %>" 
           role="menuitem"
           aria-current="<%= currentPath.startsWith('/agenda') ? 'page' : 'false' %>">
          <img src="/icons/calendario.webp" alt="" aria-hidden="true">
          <span><%= t('navbar.agenda') %></span>
        </a>
      </li>
      
      <!-- Box/Espacio Específico -->
      <li>
        <a href="/especifico" class="menu-link <%= (currentPath.startsWith('/especifico') || currentPath === '/en-curso') ? 'active' : '' %>" data-tooltip="<%= nomenclatura ? nomenclatura.especifico : 'Especifico' %>">
          <i class="fas fa-door-open"></i>
          <span><%= nomenclatura ? nomenclatura.especifico : 'Especifico' %></span>
        </a>
      </li>
      
      <!-- Notificaciones -->
      <li>
        <a href="/historial-notificaciones" class="menu-link <%= currentPath.startsWith('/historial-notificaciones') ? 'active' : '' %>" data-tooltip="<%= t('navbar.notifications') %>">
          <img src="/icons/notificaciones.webp" alt="" class="noti">
          <span><%= t('navbar.notifications') %></span>
        </a>
      </li>
      
      <!-- Gestión de Grupo (solo owner y admin) -->
      <% if (locals.userRole === 'owner' || locals.userRole === 'admin') { %>
      <li>
        <a href="/gestion-grupo" class="menu-link <%= currentPath.startsWith('/gestion-grupo') ? 'active' : '' %>" data-tooltip="<%= t('navbar.manageGroup') %>">
          <img src="/icons/grupo.png" alt="" class="gestion">
          <span><%= t('navbar.manageGroup') %></span>
        </a>
      </li>
      <% } %>
    <% } %>

    <li>
      <a href="/perfil" class="menu-link <%= currentPath.startsWith('/perfil') ? 'active' : '' %>" data-tooltip="<%= t('navbar.profile') %>">
        <img src="/icons/perfil.png" alt="" class="perfil">
        <span><%= t('navbar.profile') %></span>
      </a>
    </li>
    
    <!-- Logout siempre visible -->
    <li>
      <a href="/logout" class="logout-button">
        <span><%= t('navbar.logout') %></span>
      </a>
    </li>
  </ul>
  <div class="reloj-wrapper" id="reloj"></div>
</nav>

<script src="/js/navbar.js"></script>
