<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Historial y preferencias de notificaciones del sistema">
  <title><%= t('notifications.history_title') %></title>
  
  <!-- Token CSRF para peticiones AJAX -->
  <meta name="csrf-token" content="<%= csrfToken %>">
  
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/historial_notificaciones.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/notifications.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/fontawesome/css/all.min.css" rel="stylesheet">

  <%- include('partials/personalization-styles') %>

</head>
<body data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>">
  <div class="container-fluid">
    <div class="row">
      <%- include("navbar") %>

      <main class="main" role="main" aria-label="Contenido principal">
        <header class="page-header">
          <div class="header-content">
            <div class="header-text">
              <h1 class="page-title">
                <i class="fas fa-bell me-2" aria-hidden="true"></i>
                <%= t('notifications.history_header') %>
              </h1>
              <p class="page-subtitle"><%= t('notifications.history_subheader') %></p>
            </div>
            
            <!-- Tabs de navegación en el header -->
            <nav class="header-tabs" role="tablist" aria-label="Opciones de notificaciones">
              <button class="tab-btn active" 
                      data-tab="historial" 
                      role="tab" 
                      aria-controls="tab-historial" 
                      aria-selected="true"
                      id="tab-btn-historial">
                <i class="fas fa-history me-2" aria-hidden="true"></i>
                <span>Historial</span>
              </button>
              <button class="tab-btn" 
                      data-tab="preferencias" 
                      role="tab" 
                      aria-controls="tab-preferencias" 
                      aria-selected="false"
                      id="tab-btn-preferencias">
                <i class="fas fa-sliders-h me-2" aria-hidden="true"></i>
                <span>Preferencias</span>
              </button>
            </nav>
          </div>
        </header>

        <!-- Contenido de las tabs -->
        <div class="tabs-container">
          <!-- Tab Historial -->
          <section class="tab-panel active" 
                   id="tab-historial" 
                   role="tabpanel" 
                   aria-labelledby="tab-btn-historial">
            <div class="loading-spinner" id="loadingSpinner" role="status" aria-live="polite">
              <div class="spinner" aria-hidden="true"></div>
              <p class="mt-3">Cargando notificaciones...</p>
            </div>
            <div class="notificaciones-lista d-none" id="notificacionesLista" role="feed" aria-label="Lista de notificaciones"></div>
          </section>

          <!-- Tab Preferencias -->
          <section class="tab-panel" 
                   id="tab-preferencias" 
                   role="tabpanel" 
                   aria-labelledby="tab-btn-preferencias"
                   hidden>
            <div class="preferences-intro">
              <div class="alert alert-info" role="status">
                <i class="fas fa-info-circle me-2" aria-hidden="true"></i>
                Configura qué tipos de notificaciones deseas recibir en tiempo real. Tus preferencias se guardarán automáticamente.
              </div>
            </div>

            <div class="preferences-grid" role="group" aria-label="Configuración de preferencias">
              <!-- Citas/Appointments -->
              <fieldset class="preference-card">
                <legend class="preference-card-header">
                  <div class="preference-icon appointments-icon" aria-hidden="true">
                    <i class="fas fa-calendar-check"></i>
                  </div>
                  <div class="preference-header-text">
                    <h2>Citas y Agendamientos</h2>
                    <small>Notificaciones sobre el sistema de agenda médica</small>
                  </div>
                </legend>
                <div class="preference-card-body">
                  <div class="form-check form-switch">
                    <input class="form-check-input" 
                           type="checkbox" 
                           role="switch"
                           id="pref-INSERT" 
                           data-category="appointments" 
                           data-type="INSERT" 
                           checked
                           aria-checked="true">
                    <label class="form-check-label" for="pref-INSERT">
                      <strong>Nueva cita agendada</strong>
                      <small class="d-block">Cuando se crea una nueva cita en el sistema</small>
                    </label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" 
                           type="checkbox" 
                           role="switch"
                           id="pref-MODIFY" 
                           data-category="appointments" 
                           data-type="MODIFY" 
                           checked
                           aria-checked="true">
                    <label class="form-check-label" for="pref-MODIFY">
                      <strong>Cita modificada</strong>
                      <small class="d-block">Cuando se modifica una cita existente</small>
                    </label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" 
                           type="checkbox" 
                           role="switch"
                           id="pref-REMOVE" 
                           data-category="appointments" 
                           data-type="REMOVE" 
                           checked
                           aria-checked="true">
                    <label class="form-check-label" for="pref-REMOVE">
                      <strong>Cita cancelada</strong>
                      <small class="d-block">Cuando se cancela una cita</small>
                    </label>
                  </div>
                </div>
              </div>

              <!-- Espacios -->
              <div class="preference-card">
                <div class="preference-card-header">
                  <div class="preference-icon spaces-icon">
                    <i class="fas fa-building"></i>
                  </div>
                  <div class="preference-header-text">
                    <h5>Espacios</h5>
                    <small>Gestión de espacios y ubicaciones</small>
                  </div>
                </div>
                <div class="preference-card-body">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-SPACE_CREATED" data-category="spaces" data-type="SPACE_CREATED" checked>
                    <label class="form-check-label" for="pref-SPACE_CREATED">
                      <strong>Nuevo espacio creado</strong>
                      <small class="d-block">Cuando se crea un espacio general o específico</small>
                    </label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-SPACE_MODIFIED" data-category="spaces" data-type="SPACE_MODIFIED" checked>
                    <label class="form-check-label" for="pref-SPACE_MODIFIED">
                      <strong>Espacio modificado</strong>
                      <small class="d-block">Cuando se modifica un espacio</small>
                    </label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-SPACE_DELETED" data-category="spaces" data-type="SPACE_DELETED" checked>
                    <label class="form-check-label" for="pref-SPACE_DELETED">
                      <strong>Espacio eliminado</strong>
                      <small class="d-block">Cuando se elimina un espacio</small>
                    </label>
                  </div>
                </div>
              </div>

              <!-- Ocupantes -->
              <div class="preference-card">
                <div class="preference-card-header">
                  <div class="preference-icon occupants-icon">
                    <i class="fas fa-user-injured"></i>
                  </div>
                  <div class="preference-header-text">
                    <h5>Ocupantes/Pacientes</h5>
                    <small>Información sobre ocupantes del sistema</small>
                  </div>
                </div>
                <div class="preference-card-body">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-OCCUPANT_CREATED" data-category="occupants" data-type="OCCUPANT_CREATED" checked>
                    <label class="form-check-label" for="pref-OCCUPANT_CREATED">
                      <strong>Nuevo ocupante agregado</strong>
                      <small class="d-block">Cuando se registra un nuevo ocupante</small>
                    </label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-OCCUPANT_MODIFIED" data-category="occupants" data-type="OCCUPANT_MODIFIED" checked>
                    <label class="form-check-label" for="pref-OCCUPANT_MODIFIED">
                      <strong>Ocupante modificado</strong>
                      <small class="d-block">Cuando se actualiza información del ocupante</small>
                    </label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-OCCUPANT_DELETED" data-category="occupants" data-type="OCCUPANT_DELETED" checked>
                    <label class="form-check-label" for="pref-OCCUPANT_DELETED">
                      <strong>Ocupante eliminado</strong>
                      <small class="d-block">Cuando se elimina un ocupante</small>
                    </label>
                  </div>
                </div>
              </div>

              <!-- Miembros del Grupo -->
              <div class="preference-card">
                <div class="preference-card-header">
                  <div class="preference-icon members-icon">
                    <i class="fas fa-users"></i>
                  </div>
                  <div class="preference-header-text">
                    <h5>Miembros del Grupo</h5>
                    <small>Cambios en la composición del equipo</small>
                  </div>
                </div>
                <div class="preference-card-body">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-MEMBER_ADDED" data-category="members" data-type="MEMBER_ADDED" checked>
                    <label class="form-check-label" for="pref-MEMBER_ADDED">
                      <strong>Nuevo miembro agregado</strong>
                      <small class="d-block">Cuando se agrega un miembro al grupo</small>
                    </label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-MEMBER_MODIFIED" data-category="members" data-type="MEMBER_MODIFIED" checked>
                    <label class="form-check-label" for="pref-MEMBER_MODIFIED">
                      <strong>Miembro modificado</strong>
                      <small class="d-block">Cuando se actualiza información del miembro</small>
                    </label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-ROLE_CHANGED" data-category="members" data-type="ROLE_CHANGED" checked>
                    <label class="form-check-label" for="pref-ROLE_CHANGED">
                      <strong>Cambio de rol</strong>
                      <small class="d-block">Cuando se cambia el rol de un miembro</small>
                    </label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pref-MEMBER_REMOVED" data-category="members" data-type="MEMBER_REMOVED" checked>
                    <label class="form-check-label" for="pref-MEMBER_REMOVED">
                      <strong>Miembro removido</strong>
                      <small class="d-block">Cuando se remueve un miembro del grupo</small>
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <div class="preferences-actions">
              <button class="btn btn-primary" id="btnGuardarPreferencias">
                <i class="fas fa-save me-2"></i>Guardar Preferencias
              </button>
              <button class="btn btn-outline-secondary-custom" id="btnRestaurarDefecto">
                <i class="fas fa-undo me-2"></i>Restaurar a Predeterminado
              </button>
            </div>

            <div class="alert alert-success mt-3 d-none" id="alertGuardado">
              <i class="fas fa-check-circle me-2"></i>
              Preferencias guardadas correctamente
            </div>
          </div>
        </div>
      </div>

      <%- include("footer") %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/notifications.js"></script>
  
  <!-- Protección CSRF automática -->
  <script src="/js/csrf-helper.js"></script>
  
  <!-- Protección de sesión: Previene acceso después de logout -->
  <script src="/js/session-guard.js"></script>
  
  <!-- Autenticación: Interceptor y renovación automática de tokens -->
  <script src="/js/auth-interceptor.js"></script>
  <script src="/js/token-manager.js"></script>
  
  <script src="/js/historial-notificaciones-websocket.js"></script>
  
  <!-- Inyección de variables globales -->
  <script nonce="<%= cspNonce %>">
    window.CURRENT_LOCALE = '<%= i18n.language %>';
    window.GRUPO_ID = '<%= grupoActivo?.grupo_id || "" %>';
    window.WS_URL = 'wss://erwiw5frx8.execute-api.us-east-2.amazonaws.com/dev';
    window.PREFERENCIAS_INICIALES = <%- JSON.stringify(preferenciasNotificaciones || null) %>;
  </script>
  
  <!-- Lógica principal de historial de notificaciones -->
  <script src="/js/historial-notificaciones.js"></script>
</body>
</html>
