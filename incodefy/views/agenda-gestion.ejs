<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Sistema de agendación de citas médicas - Gestión de espacios y horarios">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Sistema de Agendación</title>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/agenda-gestion.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/notifications.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/fontawesome/css/all.min.css" rel="stylesheet">

    <%- include('partials/personalization-styles') %>
</head>
<body data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>">
    
    <%- include('navbar') %>
    <div class="container-fluid">
        <div class="row">
            <main class="main" role="main" aria-label="Contenido principal" data-ws-endpoint="<%= wsEndpoint %>">
                <header class="header">
                    <div class="container">
                        <h1 class="title">Sistema de Agendación</h1>
                        
                        <!-- Filtros de Espacios -->
                        <section class="filters-grid" aria-label="Filtros de búsqueda">
                            <div class="filter-group">
                                <label for="generalSpaceSelect" class="filter-label">Espacio General</label>
                                <select id="generalSpaceSelect" 
                                        name="generalSpaceSelect"
                                        class="filter-select"
                                        aria-label="Seleccionar espacio general">
                                    <option value="">Selecciona un espacio general</option>
                                </select>
                            </div>

                            <div class="filter-group">
                                <label for="specificSpaceSelect" class="filter-label">Espacio Específico</label>
                                <select id="specificSpaceSelect" 
                                        name="specificSpaceSelect"
                                        class="filter-select" 
                                        disabled
                                        aria-label="Seleccionar espacio específico"
                                        aria-disabled="true">
                                    <option value="">Selecciona un espacio específico</option>
                                </select>
                            </div>
                        </section>

                        <!-- Controles de Vista -->
                        <nav id="viewControls" class="view-controls d-none" aria-label="Controles de calendario">
                            <div class="nav-section">
                                <button id="prevBtn" 
                                        class="nav-btn" 
                                        type="button"
                                        aria-label="Período anterior">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <polyline points="15 18 9 12 15 6"></polyline>
                                    </svg>
                                </button>
                                
                                <div id="currentDateDisplay" class="date-display" role="status" aria-live="polite"></div>
                                
                                <button id="nextBtn" 
                                        class="nav-btn"
                                        type="button"
                                        aria-label="Período siguiente">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </button>

                                <button id="todayBtn" class="today-btn" type="button">Hoy</button>
                            </div>

                            <div class="view-toggles" role="group" aria-label="Selector de vista">
                                <button id="dayViewBtn" 
                                        class="view-btn" 
                                        type="button"
                                        role="tab"
                                        aria-selected="false">Día</button>
                                <button id="weekViewBtn" 
                                        class="view-btn active" 
                                        type="button"
                                        role="tab"
                                        aria-selected="true">Semana</button>
                                <button id="monthViewBtn" 
                                        class="view-btn" 
                                        type="button"
                                        role="tab"
                                        aria-selected="false">Mes</button>
                            </div>
                        </nav>
                    </div>
                </header>

                <!-- Contenido Principal -->
                <section class="main-content" aria-label="Área de agendación">
                    <div class="container">
                        <!-- Mensaje de selección -->
                        <div id="emptyState" class="empty-state" role="status">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <h2>Selecciona un espacio para comenzar</h2>
                            <p>Elige un espacio general y específico para ver y crear agendaciones</p>
                        </div>

                        <!-- Calendario -->
                        <div id="calendarContainer" class="calendar-container d-none" role="region" aria-label="Calendario de agendaciones">
                            <!-- Timeline View (Día/Semana) -->
                            <div id="timelineView" class="calendar-card" role="region" aria-label="Vista de línea de tiempo">
                                <div class="timeline-scroll">
                                    <div id="timelineContent" role="table" aria-label="Horarios disponibles"></div>
                                </div>
                            </div>

                            <!-- Month View -->
                            <div id="monthView" class="calendar-card d-none" role="region" aria-label="Vista mensual">
                                <div id="monthHeader" class="month-header" role="row"></div>
                                <div id="monthGrid" class="month-grid" role="grid" aria-label="Calendario mensual"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal de Agendación -->
                <div id="bookingModal" class="modal">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 id="modalTitle" class="modal-title">Nueva Agendación</h2>
                            <button id="closeModalBtn" class="close-btn">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </div>

                        <div class="modal-body">
                            <div class="form-group">
                                <label class="form-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    Ocupante
                                </label>
                                <select id="occupantSelect" class="form-input">
                                    <option value="">Selecciona un ocupante</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    Fecha
                                </label>
                                <input type="date" id="dateInput" class="form-input">
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        Hora Inicio
                                    </label>
                                    <select id="startTimeSelect" class="form-input">
                                        <option value="">Selecciona</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        Hora Fin
                                    </label>
                                    <select id="endTimeSelect" class="form-input">
                                        <option value="">Selecciona</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <div>
                                <button id="deleteBookingBtn" class="btn-delete d-none">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                    Eliminar
                                </button>
                            </div>
                            
                            <div class="modal-actions">
                                <button id="cancelModalBtn" class="btn-secondary">Cancelar</button>
                                <button id="saveBookingBtn" class="btn-primary">Crear Agendación</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal de confirmación personalizado -->
                <div id="confirmModal" class="confirm-modal">
                    <div class="confirm-content">
                        <div class="confirm-header">
                            <div class="confirm-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                    <line x1="12" y1="9" x2="12" y2="13"></line>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                            </div>
                            <div class="confirm-text">
                                <h3 id="confirmTitle">¿Confirmar acción?</h3>
                                <p id="confirmMessage">Esta acción no se puede deshacer</p>
                            </div>
                        </div>
                        <div class="confirm-body">
                            <div id="confirmDetails" class="confirm-details"></div>
                        </div>
                        <div class="confirm-actions">
                            <button id="confirmCancelBtn" class="confirm-btn confirm-btn-cancel">Cancelar</button>
                            <button id="confirmDeleteBtn" class="confirm-btn confirm-btn-delete">Eliminar</button>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <%- include('footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Inyectar datos iniciales pre-cargados del servidor -->
    <script nonce="<%= cspNonce %>">
    window.GROUP_ID = '<%= groupId || "" %>';
    window.USER_ROLE = '<%= userRole || "" %>';
    window.INITIAL_DATA = <%- JSON.stringify(initialData || { generalSpaces: [], occupants: [] }) %>;
    window.userPersonalization = <%- JSON.stringify(personalization || {}) %>;
    </script>
    
    <script src="/js/notifications.js"></script>
    <script nonce="<%= cspNonce %>">
    window.notificationManager = new NotificationManager();
    </script>
    
    <!-- Protección CSRF automática -->
    <script src="/js/csrf-helper.js"></script>
    
    <!-- Protección de sesión: Previene acceso después de logout -->
    <script src="/js/session-guard.js"></script>
    
    <!-- Autenticación: Interceptor y renovación automática de tokens -->
    <script src="/js/auth-interceptor.js"></script>
    <script src="/js/token-manager.js"></script>
    
    <script src="/js/csrf-helper.js"></script>
    <script src="/js/agenda-gestion.js?v=table-grid"></script>
    <script nonce="<%= cspNonce %>">
    function showDevToast(event) {
      event.preventDefault();
      
      const toastElement = document.getElementById('devToast');
      const toast = new bootstrap.Toast(toastElement, {
        autohide: true,
        delay: 4000
      });
      
      toast.show();
    }
  </script>
</body>
</html>