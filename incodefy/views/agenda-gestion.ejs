<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Agendación</title>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/agenda-gestion.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/notifications.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <%- include('partials/personalization-styles') %>
</head>
<body data-theme="<%= (locals.personalization && personalization['theme.mode']) || 'light' %>">
    
    <%- include('navbar') %>
    <div class="container-fluid">
        <div class="row">
            <div class="main">
                <div class="header">
                    <div class="container">
                        <h1 class="title">Sistema de Agendación</h1>
                        
                        <!-- Filtros de Espacios -->
                        <div class="filters-grid">
                            <div class="filter-group">
                                <label class="filter-label">Espacio General</label>
                                <select id="generalSpaceSelect" class="filter-select">
                                    <option value="">Selecciona un espacio general</option>
                                </select>
                            </div>

                            <div class="filter-group">
                                <label class="filter-label">Espacio Específico</label>
                                <select id="specificSpaceSelect" class="filter-select" disabled>
                                    <option value="">Selecciona un espacio específico</option>
                                </select>
                            </div>
                        </div>

                        <!-- Controles de Vista -->
                        <div id="viewControls" class="view-controls" style="display: none;">
                            <div class="nav-section">
                                <button id="prevBtn" class="nav-btn">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="15 18 9 12 15 6"></polyline>
                                    </svg>
                                </button>
                                
                                <div id="currentDateDisplay" class="date-display"></div>
                                
                                <button id="nextBtn" class="nav-btn">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </button>

                                <button id="todayBtn" class="today-btn">Hoy</button>
                            </div>

                            <div class="view-toggles">
                                <button id="dayViewBtn" class="view-btn">Día</button>
                                <button id="weekViewBtn" class="view-btn active">Semana</button>
                                <button id="monthViewBtn" class="view-btn">Mes</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contenido Principal -->
                <div class="main-content">
                    <div class="container">
                        <!-- Mensaje de selección -->
                        <div id="emptyState" class="empty-state">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <h3>Selecciona un espacio para comenzar</h3>
                            <p>Elige un espacio general y específico para ver y crear agendaciones</p>
                        </div>

                        <!-- Calendario -->
                        <div id="calendarContainer" class="calendar-container" style="display: none;">
                            <!-- Timeline View (Día/Semana) -->
                            <div id="timelineView" class="calendar-card">
                                <div class="timeline-scroll">
                                    <div id="timelineContent"></div>
                                </div>
                            </div>

                            <!-- Month View -->
                            <div id="monthView" class="calendar-card" style="display: none;">
                                <div id="monthHeader" class="month-header"></div>
                                <div id="monthGrid" class="month-grid"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal de Agendación -->
                <div id="bookingModal" class="modal">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 id="modalTitle" class="modal-title">Nueva Agendación</h2>
                            <button id="closeModalBtn" class="close-btn">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </div>

                        <div class="modal-body">
                            <div class="form-group">
                                <label class="form-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    Ocupante
                                </label>
                                <select id="occupantSelect" class="form-input">
                                    <option value="">Selecciona un ocupante</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    Fecha
                                </label>
                                <input type="date" id="dateInput" class="form-input">
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        Hora Inicio
                                    </label>
                                    <select id="startTimeSelect" class="form-input">
                                        <option value="">Selecciona</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        Hora Fin
                                    </label>
                                    <select id="endTimeSelect" class="form-input">
                                        <option value="">Selecciona</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <div>
                                <button id="deleteBookingBtn" class="btn-delete" style="display: none;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                    Eliminar
                                </button>
                            </div>
                            
                            <div class="modal-actions">
                                <button id="cancelModalBtn" class="btn-secondary">Cancelar</button>
                                <button id="saveBookingBtn" class="btn-primary">Crear Agendación</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('footer') %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Inyectar datos iniciales pre-cargados del servidor -->
    <script>
    window.GROUP_ID = '<%= groupId || "" %>';
    window.INITIAL_DATA = <%- JSON.stringify(initialData || { generalSpaces: [], occupants: [] }) %>;
    window.userPersonalization = <%- JSON.stringify(personalization || {}) %>;
    </script>
    
    <script src="/js/notifications.js"></script>
    <script src="/js/agenda-gestion.js"></script>
    <script>
    function showDevToast(event) {
      event.preventDefault();
      
      const toastElement = document.getElementById('devToast');
      const toast = new bootstrap.Toast(toastElement, {
        autohide: true,
        delay: 4000
      });
      
      toast.show();
    }
  </script>
</body>
</html>