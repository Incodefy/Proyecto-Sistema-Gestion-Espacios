          "schema_version": 0,
          "attributes": {
            "dashboard_arn": "arn:aws:cloudwatch::643913569214:dashboard/feli-dev-system-health",
            "dashboard_body": "{\"widgets\":[{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#2ca02c\",\"fill\":\"above\",\"label\":\"SLO Target\",\"value\":99.9},{\"color\":\"#ff7f0e\",\"fill\":\"between\",\"label\":\"Warning\",\"value\":99.5}]},\"metrics\":[[\"incodefy\",\"Availability\",{\"label\":\"Current\",\"period\":300,\"stat\":\"Average\"}]],\"region\":\"us-east-2\",\"title\":\"Login Availability (SLO: 99.9%)\",\"view\":\"gauge\",\"yAxis\":{\"left\":{\"max\":100,\"min\":95}}},\"type\":\"metric\",\"width\":6},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#2ca02c\",\"fill\":\"above\",\"label\":\"SLO Target\",\"value\":99.5}]},\"metrics\":[[\"incodefy\",\"Availability\",\"Service\",\"Agenda\",{\"period\":300,\"stat\":\"Average\"}]],\"region\":\"us-east-2\",\"title\":\"Agenda Availability (SLO: 99.5%)\",\"view\":\"gauge\",\"yAxis\":{\"left\":{\"max\":100,\"min\":95}}},\"type\":\"metric\",\"width\":6},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#2ca02c\",\"fill\":\"above\",\"label\":\"SLO Target\",\"value\":99.5}]},\"metrics\":[[\"incodefy\",\"Availability\",\"Service\",\"Catalog\",{\"period\":300,\"stat\":\"Average\"}]],\"region\":\"us-east-2\",\"title\":\"Catalog Availability (SLO: 99.5%)\",\"view\":\"gauge\",\"yAxis\":{\"left\":{\"max\":100,\"min\":95}}},\"type\":\"metric\",\"width\":6},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#ff7f0e\",\"label\":\"Warning (30%)\",\"value\":30},{\"color\":\"#d62728\",\"label\":\"Critical (70%)\",\"value\":70}]},\"metrics\":[[\"incodefy\",\"ErrorBudgetBurnRate\",{\"period\":300,\"stat\":\"Average\"}]],\"region\":\"us-east-2\",\"title\":\"Error Budget Burn Rate\",\"view\":\"gauge\",\"yAxis\":{\"left\":{\"max\":100,\"min\":0}}},\"type\":\"metric\",\"width\":6},{\"height\":6,\"properties\":{\"metrics\":[[\"incodefy\",\"RequestCount\",{\"label\":\"Total\",\"period\":60,\"stat\":\"Sum\"}],[\"...\",\"Service\",\"Login\",{\"label\":\"Login\",\"period\":60,\"stat\":\"Sum\"}],[\"...\",\"Service\",\"Agenda\",{\"label\":\"Agenda\",\"period\":60,\"stat\":\"Sum\"}],[\"...\",\"Service\",\"Catalog\",{\"label\":\"Catalog\",\"period\":60,\"stat\":\"Sum\"}],[\"...\",\"Service\",\"Personalization\",{\"label\":\"Personalization\",\"period\":60,\"stat\":\"Sum\"}]],\"region\":\"us-east-2\",\"stacked\":false,\"title\":\"Request Rate (requests/min)\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"min\":0}}},\"type\":\"metric\",\"width\":12},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#ff7f0e\",\"label\":\"Warning Threshold\",\"value\":1},{\"color\":\"#d62728\",\"label\":\"Critical Threshold\",\"value\":5}]},\"metrics\":[[\"incodefy\",\"4XXError\",{\"color\":\"#ff7f0e\",\"label\":\"4xx Errors\",\"period\":300,\"stat\":\"Average\"}],[\".\",\"5XXError\",{\"color\":\"#d62728\",\"label\":\"5xx Errors\",\"period\":300,\"stat\":\"Average\"}]],\"region\":\"us-east-2\",\"stacked\":true,\"title\":\"Error Rate by Type (%)\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"max\":10,\"min\":0}}},\"type\":\"metric\",\"width\":12},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#ff7f0e\",\"label\":\"P95 SLO\",\"value\":500},{\"color\":\"#d62728\",\"label\":\"P99 SLO\",\"value\":1000}]},\"metrics\":[[\"AWS/Lambda\",\"Duration\",\"FunctionName\",\"feli-dev-login\",{\"label\":\"P50\",\"period\":300,\"stat\":\"p50\"}],[\"...\",{\"label\":\"P95\",\"period\":300,\"stat\":\"p95\"}],[\"...\",{\"label\":\"P99\",\"period\":300,\"stat\":\"p99\"}]],\"region\":\"us-east-2\",\"stacked\":false,\"title\":\"Login Latency (ms)\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"min\":0}}},\"type\":\"metric\",\"width\":12},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#ff7f0e\",\"label\":\"P95 SLO\",\"value\":800},{\"color\":\"#d62728\",\"label\":\"P99 SLO\",\"value\":1500}]},\"metrics\":[[\"AWS/Lambda\",\"Duration\",\"FunctionName\",\"feli-dev-getAgenda\",{\"label\":\"P50\",\"period\":300,\"stat\":\"p50\"}],[\"...\",{\"label\":\"P95\",\"period\":300,\"stat\":\"p95\"}],[\"...\",{\"label\":\"P99\",\"period\":300,\"stat\":\"p99\"}]],\"region\":\"us-east-2\",\"stacked\":false,\"title\":\"Agenda Latency (ms)\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"min\":0}}},\"type\":\"metric\",\"width\":12},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#d62728\",\"label\":\"Reserved Concurrency Limit\",\"value\":800}]},\"metrics\":[[\"AWS/Lambda\",\"ConcurrentExecutions\",{\"period\":60,\"stat\":\"Maximum\"}]],\"region\":\"us-east-2\",\"stacked\":false,\"title\":\"Lambda Concurrent Executions\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"min\":0}}},\"type\":\"metric\",\"width\":8},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/Lambda\",\"Throttles\",{\"period\":60,\"stat\":\"Sum\"}]],\"region\":\"us-east-2\",\"setPeriodToTimeRange\":false,\"title\":\"Lambda Throttles\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":8},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/Lambda\",\"Errors\",{\"period\":60,\"stat\":\"Sum\"}]],\"region\":\"us-east-2\",\"setPeriodToTimeRange\":false,\"title\":\"Lambda Errors\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":8},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/DynamoDB\",\"ConsumedReadCapacityUnits\",\"TableName\",\"feli-dev-agenda\",{\"label\":\"Read\",\"period\":60,\"stat\":\"Sum\"}],[\".\",\"ConsumedWriteCapacityUnits\",\".\",\".\",{\"label\":\"Write\",\"period\":60,\"stat\":\"Sum\"}]],\"region\":\"us-east-2\",\"stacked\":false,\"title\":\"DynamoDB Read/Write Capacity (Units/sec)\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"min\":0}}},\"type\":\"metric\",\"width\":12},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/DynamoDB\",\"UserErrors\",\"TableName\",\"feli-dev-agenda\",{\"period\":60,\"stat\":\"Sum\"}]],\"region\":\"us-east-2\",\"stacked\":false,\"title\":\"DynamoDB Throttles\",\"view\":\"timeSeries\",