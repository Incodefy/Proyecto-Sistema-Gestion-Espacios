          "schema_version": 0,
          "attributes": {
            "dashboard_arn": "arn:aws:cloudwatch::643913569214:dashboard/feli-dev-chaos-experiments",
            "dashboard_body": "{\"widgets\":[{\"height\":6,\"properties\":{\"metrics\":[[\"incodefy\",\"ActiveExperiments\",{\"period\":60,\"stat\":\"Sum\"}]],\"region\":\"us-east-2\",\"title\":\"Active Chaos Experiments\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":6},{\"height\":6,\"properties\":{\"metrics\":[[\"incodefy\",\"ExperimentSuccess\",{\"period\":300,\"stat\":\"Average\"}]],\"region\":\"us-east-2\",\"title\":\"Experiment Success Rate\",\"view\":\"gauge\",\"yAxis\":{\"left\":{\"max\":100,\"min\":0}}},\"type\":\"metric\",\"width\":6},{\"height\":6,\"properties\":{\"annotations\":{\"horizontal\":[{\"color\":\"#2ca02c\",\"label\":\"SLO Target (1 min)\",\"value\":60},{\"color\":\"#d62728\",\"label\":\"Max Acceptable (5 min)\",\"value\":300}]},\"metrics\":[[\"incodefy\",\"RecoveryTime\",{\"period\":300,\"stat\":\"Average\"}]],\"region\":\"us-east-2\",\"title\":\"System Recovery Time (seconds)\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"min\":0}}},\"type\":\"metric\",\"width\":12},{\"height\":6,\"properties\":{\"metrics\":[[\"incodefy\",\"AffectedServices\",\"Service\",\"Login\",{\"period\":60,\"stat\":\"Sum\"}],[\"...\",\"Service\",\"Agenda\",{\"period\":60,\"stat\":\"Sum\"}],[\"...\",\"Service\",\"Catalog\",{\"period\":60,\"stat\":\"Sum\"}]],\"region\":\"us-east-2\",\"stacked\":true,\"title\":\"Affected Services\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12},{\"height\":6,\"properties\":{\"query\":\"SOURCE '/aws/lambda/feli-dev-chaos-experiment'\\r\\n| fields @timestamp, @message\\r\\n| filter @message like /CHAOS_EXPERIMENT/\\r\\n| sort @timestamp desc\\r\\n| limit 20\\r\\n\",\"region\":\"us-east-2\",\"title\":\"Chaos Experiment Logs\"},\"type\":\"log\",\"width\":24}]}",
            "dashboard_name": "feli-dev-chaos-experiments",
