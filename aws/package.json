{
  "name": "aws-cognito-jwt-login",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "serverless offline",
    "deploy": "serverless deploy --stage dev --region us-east-2",
    "deploy:dev": "serverless deploy --stage dev --region us-east-2",
    "deploy:staging": "serverless deploy --stage staging --region us-east-2",
    "deploy:prod": "serverless deploy --stage prod --region us-east-2",
    "remove": "serverless remove",
    "info": "serverless info --verbose",
    "info:dev": "serverless info --stage dev",
    "info:prod": "serverless info --stage prod",
    "logs:worker": "serverless logs -f personalizationWorker -t",
    "logs:dlq": "serverless logs -f personalizationDLQWorker -t",
    "logs": "serverless logs -f",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:local": "npm run dev",
    "start:localstack": "docker-compose up -d",
    "stop:localstack": "docker-compose down",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --fix",
    "validate": "serverless print --stage dev",
    "package": "serverless package --stage dev"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "serverless": "^3.40.0",
    "serverless-offline": "^13.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-sns": "^3.896.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "ajv": "^8.12.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^2.1.1",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "node-fetch": "^3.3.2"
  },
  "optionalDependencies": {
    "dotenv": "^17.2.3"
  }
}
